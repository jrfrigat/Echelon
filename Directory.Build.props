<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      NU1900 means NuGet could not reach the feed to check packages for known
      vulnerabilities. That is a statement about the network, not about the code, so it must
      stay visible as a warning without failing the build: behind a proxy that blocks
      nuget.org it otherwise makes every restore fatal. A build box with feed access should
      still surface it, and vulnerability scanning belongs in CI regardless.
    -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>

    <!--
      Audit the whole graph, not just direct references. The default under the .NET 9 SDK is
      "direct", which hid a high-severity advisory in a transitively pulled package: the same
      restore under the .NET 10 SDK reported it immediately. A vulnerability we cannot see is
      worse than one we can.

      NU1902/NU1903 stay warnings rather than errors only because the fix is not reachable from
      here: nuget.org is blocked by a proxy, and the patched package's own dependencies are not
      in the local cache. CI has network and MUST fail on them — see .github/workflows.
    -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
