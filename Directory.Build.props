<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      NU1900 means NuGet could not reach the feed to check packages for known
      vulnerabilities. That is a statement about the network, not about the code, so it must
      stay visible as a warning without failing the build: behind a proxy that blocks
      nuget.org it otherwise makes every restore fatal. A build box with feed access should
      still surface it, and vulnerability scanning belongs in CI regardless.
    -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>

    <!--
      Audit the whole graph, not just direct references. Kept explicit rather than relying on the
      SDK default: under the .NET 9 SDK the default was "direct", and it hid a high-severity
      advisory in a transitively pulled package until a .NET 10 restore reported it. A
      vulnerability we cannot see is worse than one we can.

      NU1902/NU1903 stay warnings rather than errors only because a fix is not always reachable
      from here — nuget.org is proxy-blocked, so a patched package whose dependencies are not
      already cached cannot be restored. CI has network and MUST fail on them.
    -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
