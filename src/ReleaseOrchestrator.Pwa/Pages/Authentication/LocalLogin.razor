@page "/login"
@using ReleaseOrchestrator.Pwa.Services.LocalAuth
@inject LocalAuthService Auth
@inject NavigationManager Navigation

@* Plain strings, not UiStrings: the Local provider is a dev / single-operator path and its login
   page is not localised yet. Adding resx entries for it is a follow-up. *@
<PageTitle>Sign in</PageTitle>

<div style="display:flex; justify-content:center; margin-top:4rem;">
    <FlareCard Style="width: 100%; max-width: 22rem;">
        <FlareCardContent>
            <div style="display:flex; flex-direction:column; gap:1rem;">
                <FlareText Typo="TypographyScale.HeadlineSmall">Sign in</FlareText>

                @if (_failed)
                {
                    <FlareAlert Severity="AlertSeverity.Error">Wrong username or password.</FlareAlert>
                }

                <FlareTextField Label="Username" @bind-Value="_username" />
                <FlarePasswordField Label="Password" @bind-Value="_password" />

                <FlareButton OnClick="SubmitAsync" Loading="_busy">Sign in</FlareButton>
            </div>
        </FlareCardContent>
    </FlareCard>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _failed;
    private bool _busy;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        _busy = true;
        _failed = false;

        if (await Auth.LoginAsync(_username, _password))
            // forceLoad so the app re-boots with the token already in storage: the auth state is read
            // fresh on startup, which sidesteps a race between NotifyChanged and the router.
            Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
        else
            _failed = true;

        _busy = false;
    }
}
