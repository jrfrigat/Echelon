@page "/login"
@using ReleaseOrchestrator.Pwa.Services.LocalAuth
@inject LocalAuthService Auth
@inject NavigationManager Navigation

<PageTitle>@UiStrings.Login_Title</PageTitle>

@* The one bare element left in the app. Centring a card in the viewport is a page-layout concern
   with no Flare component for it, and the Flare reference app does exactly the same on its own
   login screen. Everything inside is Flare. *@
<div style="display:flex; justify-content:center; margin-top:4rem;">
    <FlareCard Variant="CardVariant.Elevated" Style="width: 100%; max-width: 22rem;">
        <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareText Typo="TypographyScale.HeadlineSmall">@UiStrings.Login_Title</FlareText>

                @if (_failed)
                {
                    <FlareAlert Severity="AlertSeverity.Error">@UiStrings.Login_Failed</FlareAlert>
                }

                <FlareTextField Label="@UiStrings.Login_Username" @bind-Value="_username" autocomplete="username" />
                <FlarePasswordField Label="@UiStrings.Login_Password" @bind-Value="_password" autocomplete="current-password" />

                <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary"
                             OnClick="SubmitAsync" Loading="_busy">@UiStrings.Login_Title</FlareButton>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _failed;
    private bool _busy;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        _busy = true;
        _failed = false;

        if (await Auth.LoginAsync(_username, _password))
            // forceLoad so the app re-boots with the token already in storage: the auth state is read
            // fresh on startup, which sidesteps a race between NotifyChanged and the router.
            Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
        else
            _failed = true;

        _busy = false;
    }
}
