@page "/"
@attribute [Authorize]
@inherits PageBase

<PageTitle>Release Plan</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Active Release Plan</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-sm" @onclick="Recalculate" disabled="@_busy">
            @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Recalculate
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="NavigateToYaml">Export YAML</button>
    </div>
</div>

<Alert Message="@Error" Type="danger" OnDismiss="@(() => Error = null)" />
<Alert Message="@Success" Type="success" OnDismiss="@(() => Success = null)" />

@if (_loading)
{
    <Spinner />
}
else if (_plan is null)
{
    <div class="alert alert-warning">No active release plan. Click <strong>Recalculate</strong> to generate one.</div>
}
else
{
    <div class="text-muted small mb-3">
        Plan: <strong>@_plan.Name</strong> v@_plan.Version &nbsp;|&nbsp;
        @(_plan.AutoGenerated ? "Auto-generated" : "Manual") &nbsp;|&nbsp;
        Updated: @_plan.UpdatedAt.ToString("g")
    </div>

    @* A conflict means the stage order below contradicts a declared dependency. The plan still
       renders as a normal ordering, so without this banner it looks deployable when it is not. *@
    @if (_plan.Conflicts is { Count: > 0 } conflicts)
    {
        <div class="alert alert-warning" role="alert">
            <h6 class="alert-heading">
                &#9888; This plan breaks @conflicts.Count declared @(conflicts.Count == 1 ? "dependency" : "dependencies")
            </h6>
            <p class="small mb-2">
                The planner could not satisfy every constraint and ordered the stages anyway.
                Deploying in this order will violate the rules listed below — review before releasing.
            </p>
            <ul class="small mb-0">
                @foreach (var conflict in conflicts)
                {
                    <li>
                        <span class="badge bg-warning text-dark me-1">@conflict.Kind</span>
                        @conflict.Reason
                    </li>
                }
            </ul>
        </div>
    }

    <div class="stages-container">
        @foreach (var stage in _plan.Stages.OrderBy(s => s.Sequence))
        {
            @* Dropping requires the dragover default to be cancelled. The Blazor directive does
               that; an inline ondragover="..." attribute would be blocked by the script-src CSP. *@
            <div class="stage-card card mb-3 @(_dragOverStageId == stage.Id ? "stage-drag-over" : "")"
                 @ondragover:preventDefault
                 @ondragenter="@(() => _dragOverStageId = stage.Id)"
                 @ondragleave="@(() => { if (_dragOverStageId == stage.Id) _dragOverStageId = null; })"
                 @ondrop="@(() => OnDropToStage(stage.Id))">
                <div class="card-header d-flex justify-content-between align-items-center py-2"
                     draggable="true"
                     @ondragstart="@(() => OnStageDragStart(stage.Id))">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary">Stage @stage.Sequence</span>
                        @if (stage.IsManualOverride)
                        {
                            <span class="badge bg-warning text-dark">Manual</span>
                        }
                        @if (!string.IsNullOrEmpty(stage.Name))
                        {
                            <strong>@stage.Name</strong>
                        }
                    </div>
                    <span class="text-muted small drag-handle">&#x2807; drag to reorder</span>
                </div>
                <div class="card-body p-2">
                    @if (!stage.Items.Any())
                    {
                        <div class="text-muted small p-2 text-center drop-zone">Drop an MR here</div>
                    }
                    @foreach (var item in stage.Items)
                    {
                        <div class="mr-item d-flex align-items-center gap-2 p-2 mb-1 rounded @(_dragItemId == item.Id ? "dragging" : "")"
                             draggable="true"
                             @ondragstart="@(() => OnItemDragStart(item.Id, stage.Id))">
                            <span class="badge @GetStatusBadge(item.MrStatus)">@item.MrStatus</span>
                            <div class="flex-grow-1">
                                <div class="fw-medium small">@item.RepositoryName <span class="text-muted">!@item.MrExternalId</span></div>
                                <div class="text-muted small text-truncate" style="max-width:400px">@item.MrSourceBranch &#x2192; @item.MrTargetBranch</div>
                                @if (!string.IsNullOrEmpty(item.TaskExternalId))
                                {
                                    <span class="badge bg-light text-dark border small">@item.TaskExternalId</span>
                                }
                            </div>
                            @if (item.ManualInclusion)
                            {
                                <span class="badge bg-info text-dark" title="Manually added">M</span>
                            }
                            <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="@(() => RemoveItem(item))" title="Remove from plan">&#x2715;</button>
                        </div>
                    }
                    <button class="btn btn-outline-success btn-sm w-100 mt-1" @onclick="@(() => OpenAddMrModal(stage.Id))">+ Add MR</button>
                </div>
            </div>
        }
    </div>
}

<ModalDialog Visible="_showAddMrModal" Title="Add Merge Request to Stage" Large="true"
             OnClose="@(() => _showAddMrModal = false)">
    <input class="form-control mb-2" placeholder="Filter by branch or repo..." @bind="_mrFilter" @bind:event="oninput" />
    @if (_availableMrs is null)
    {
        <Spinner />
    }
    else
    {
        <div style="max-height:400px;overflow-y:auto">
            <table class="table table-sm table-hover">
                <thead><tr><th>Repo</th><th>Branch</th><th>Task</th><th></th></tr></thead>
                <tbody>
                @foreach (var mr in FilteredMrs(_availableMrs))
                {
                    <tr>
                        <td class="small">@mr.RepositoryName</td>
                        <td class="small">@mr.SourceBranch</td>
                        <td class="small">@mr.TaskExternalId</td>
                        <td><button class="btn btn-primary btn-sm" @onclick="@(() => AddMrToStage(mr.Id))">Add</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</ModalDialog>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    ReleasePlanDto? _plan;
    bool _loading = true;
    bool _busy;

    // DnD state
    Guid? _dragItemId;
    Guid? _dragSourceStageId;
    Guid? _dragStageId;
    Guid? _dragOverStageId;

    // Add MR modal
    bool _showAddMrModal;
    Guid _targetStageId;
    PagedResult<MrDto>? _availableMrs;
    string _mrFilter = "";

    protected override async Task OnInitializedAsync()
    {
        // A null plan is a legitimate answer here (nothing generated yet), not a failure.
        await RunAsync(async () => _plan = await Api.GetActivePlanAsync());
        _loading = false;
    }

    async Task Recalculate()
    {
        _busy = true;
        await RunAsync(async () => _plan = await Api.RecalculatePlanAsync(), "Plan recalculated successfully.");
        _busy = false;
    }

    void NavigateToYaml() => Nav.NavigateTo(_plan is null ? "/plan/yaml" : $"/plan/yaml?id={_plan.Id}");

    void OnStageDragStart(Guid stageId) { _dragStageId = stageId; _dragItemId = null; }
    void OnItemDragStart(Guid itemId, Guid sourceStageId) { _dragItemId = itemId; _dragSourceStageId = sourceStageId; _dragStageId = null; }

    async Task OnDropToStage(Guid targetStageId)
    {
        _dragOverStageId = null;

        // Snapshot and clear before awaiting: a second drop landing mid-request would otherwise
        // read half-reset state.
        var itemId = _dragItemId;
        var stageId = _dragStageId;
        var sourceStageId = _dragSourceStageId;
        _dragItemId = null; _dragStageId = null; _dragSourceStageId = null;

        var plan = _plan;
        if (plan is null) return;

        if (itemId.HasValue && sourceStageId != targetStageId)
        {
            await RunAsync(async () => _plan = await Api.MoveItemAsync(plan.Id, itemId.Value, targetStageId), "Item moved.");
            return;
        }

        if (!stageId.HasValue || stageId == targetStageId) return;

        var stages = plan.Stages.OrderBy(s => s.Sequence).ToList();
        var fromIdx = stages.FindIndex(s => s.Id == stageId);
        var toIdx = stages.FindIndex(s => s.Id == targetStageId);
        if (fromIdx < 0 || toIdx < 0) return;

        var moved = stages[fromIdx];
        stages.RemoveAt(fromIdx);
        stages.Insert(toIdx, moved);

        var order = stages.Select(s => s.Id).ToList();
        await RunAsync(async () => _plan = await Api.ReorderStagesAsync(plan.Id, order), "Stages reordered.");
    }

    async Task RemoveItem(StageItemDto item)
    {
        var plan = _plan;
        if (plan is null) return;

        if (!await ConfirmAsync($"Remove {item.RepositoryName} !{item.MrExternalId} from the plan?")) return;

        await RunAsync(async () => _plan = await Api.RemoveItemAsync(plan.Id, item.Id), "Item removed.");
    }

    async Task OpenAddMrModal(Guid stageId)
    {
        _targetStageId = stageId;
        _showAddMrModal = true;
        _availableMrs = null;
        _mrFilter = "";

        await RunAsync(async () => _availableMrs = await Api.GetMergeRequestsAsync(pageSize: 200));
    }

    async Task AddMrToStage(Guid mrId)
    {
        var plan = _plan;
        if (plan is null) return;

        var stageId = _targetStageId;
        if (await RunAsync(async () => _plan = await Api.AddItemAsync(plan.Id, stageId, mrId), "MR added to stage."))
            _showAddMrModal = false;
    }

    IEnumerable<MrDto> FilteredMrs(PagedResult<MrDto> mrs) =>
        string.IsNullOrEmpty(_mrFilter)
            ? mrs.Items
            : mrs.Items.Where(m =>
                m.SourceBranch.Contains(_mrFilter, StringComparison.OrdinalIgnoreCase) ||
                m.RepositoryName.Contains(_mrFilter, StringComparison.OrdinalIgnoreCase));

    // Mirrors the server-side MergeRequestStatus enum, which the PWA does not reference.
    static string GetStatusBadge(string status) => status switch
    {
        "ReadyForDeploy" => "bg-success",
        "Merged" => "bg-primary",
        "Opened" => "bg-secondary",
        "Closed" => "bg-dark",
        _ => "bg-light text-dark"
    };
}
