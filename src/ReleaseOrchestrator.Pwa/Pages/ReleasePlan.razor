@page "/"
@attribute [Authorize]
@inherits PageBase

<PageTitle>Release Plan</PageTitle>

<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">Active Release Plan</FlareText>
    <FlareSpacer />
    <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" OnClick="Recalculate" Disabled="_busy">
        <LeadingIcon><FlareIcon Name="@FlareIcons.Refresh" /></LeadingIcon>
        <ChildContent>Recalculate</ChildContent>
    </FlareButton>
    <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" OnClick="NavigateToYaml">Export YAML</FlareButton>
</FlareStack>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (_loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (_plan is null)
{
    <FlareEmptyState Title="No active release plan"
                     Description="Recalculate to build one from the merge requests that are ready to deploy." />
}
else
{
    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
        @_plan.Name v@_plan.Version — @(_plan.AutoGenerated ? "auto-generated" : "manual") — updated @_plan.UpdatedAt.ToString("g")
    </FlareText>

    @* A conflict means the stage order below contradicts a declared dependency. The plan still
       renders as an ordinary ordering, so without this banner it looks deployable when it is not.
       `is { Count: > 0 }` rather than .Count: Conflicts is a positional record parameter with no
       default, so an older server that omits the field leaves it null despite the annotation. *@
    @if (_plan.Conflicts is { Count: > 0 } conflicts)
    {
        <FlareAlert Severity="AlertSeverity.Warning"
                    Title="@($"This plan breaks {conflicts.Count} declared {(conflicts.Count == 1 ? "dependency" : "dependencies")}")">
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Typo="TypographyScale.BodySmall">
                    The planner could not satisfy every constraint and ordered the stages anyway.
                    Deploying in this order will violate the rules below — review before releasing.
                </FlareText>
                @foreach (var conflict in conflicts)
                {
                    <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                        <FlareChip Size="ChipSize.Sm" Color="FlareColor.Warning">@conflict.Kind</FlareChip>
                        <FlareText Typo="TypographyScale.BodySmall">@conflict.Reason</FlareText>
                    </FlareStack>
                }
            </FlareStack>
        </FlareAlert>
    }

    <FlareStack Gap="FlareSpacing.Medium">
        @foreach (var stage in _plan.Stages.OrderBy(s => s.Sequence))
        {
            @* Dropping requires the dragover default to be cancelled. The Blazor directive does
               that; an inline ondragover="..." attribute would be blocked by the script-src CSP. *@
            <div @ondragover:preventDefault
                 @ondragenter="@(() => _dragOverStageId = stage.Id)"
                 @ondragleave="@(() => { if (_dragOverStageId == stage.Id) _dragOverStageId = null; })"
                 @ondrop="@(() => OnDropToStage(stage.Id))">
                <FlareCard Variant="@(_dragOverStageId == stage.Id ? CardVariant.Filled : CardVariant.Outlined)">
                    <FlareCardHeader>
                        <ChildContent>
                            <div draggable="true" @ondragstart="@(() => OnStageDragStart(stage.Id))">
                                <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                                    <FlareChip Size="ChipSize.Sm">Stage @stage.Sequence</FlareChip>
                                    @if (stage.IsManualOverride)
                                    {
                                        <FlareChip Size="ChipSize.Sm" Color="FlareColor.Warning">Manual</FlareChip>
                                    }
                                    @if (!string.IsNullOrEmpty(stage.Name))
                                    {
                                        <FlareText Typo="TypographyScale.TitleSmall">@stage.Name</FlareText>
                                    }
                                    <FlareSpacer />
                                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                                        drag to reorder
                                    </FlareText>
                                </FlareStack>
                            </div>
                        </ChildContent>
                    </FlareCardHeader>

                    <FlareCardContent>
                        <FlareStack Gap="FlareSpacing.XSmall">
                            @if (!stage.Items.Any())
                            {
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    Drop a merge request here
                                </FlareText>
                            }
                            @foreach (var item in stage.Items)
                            {
                                <div draggable="true" @ondragstart="@(() => OnItemDragStart(item.Id, stage.Id))">
                                    <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center" StretchFirst>
                                        <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
                                            <FlareChip Size="ChipSize.Sm" Color="@StatusColor(item.MrStatus)">@item.MrStatus</FlareChip>
                                            <FlareStack Gap="FlareSpacing.None">
                                                <FlareText Typo="TypographyScale.BodyMedium">
                                                    @item.RepositoryName !@item.MrExternalId
                                                </FlareText>
                                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                                    @item.MrSourceBranch → @item.MrTargetBranch
                                                    @if (!string.IsNullOrEmpty(item.TaskExternalId))
                                                    {
                                                        <text> · @item.TaskExternalId</text>
                                                    }
                                                </FlareText>
                                            </FlareStack>
                                        </FlareStack>
                                        @if (item.ManualInclusion)
                                        {
                                            <FlareTooltip Text="Added manually">
                                                <FlareChip Size="ChipSize.Sm" Color="FlareColor.Info">M</FlareChip>
                                            </FlareTooltip>
                                        }
                                        <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                                         AriaLabel="Remove from plan" OnClick="@(() => RemoveItem(item))">
                                            <FlareIcon Name="@FlareIcons.Close" />
                                        </FlareIconButton>
                                    </FlareStack>
                                </div>
                            }
                            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text"
                                         OnClick="@(() => OpenAddMrModal(stage.Id))">
                                <LeadingIcon><FlareIcon Name="@FlareIcons.Add" /></LeadingIcon>
                                <ChildContent>Add merge request</ChildContent>
                            </FlareButton>
                        </FlareStack>
                    </FlareCardContent>
                </FlareCard>
            </div>
        }
    </FlareStack>
}

<FlareDialog @bind-Visible="_showAddMrModal" Title="Add merge request to stage" ShowCloseButton>
    <FlareStack Gap="FlareSpacing.Small">
        <FlareTextInput @bind-Value="_mrFilter" @bind-Value:event="oninput"
                        Placeholder="Filter by branch or repository..." />
        @if (_availableMrs is null)
        {
            <FlareProgress Variant="ProgressVariant.Circular" />
        }
        else
        {
            <FlareTable TItem="MrDto" Items="@FilteredMrs(_availableMrs)">
                <HeaderContent>
                    <tr><th>Repository</th><th>Branch</th><th>Task</th><th></th></tr>
                </HeaderContent>
                <RowTemplate Context="mr">
                    <td>@mr.RepositoryName</td>
                    <td>@mr.SourceBranch</td>
                    <td>@mr.TaskExternalId</td>
                    <td>
                        <FlareButton Size="ButtonSize.Sm" OnClick="@(() => AddMrToStage(mr.Id))">Add</FlareButton>
                    </td>
                </RowTemplate>
            </FlareTable>
        }
    </FlareStack>
</FlareDialog>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    ReleasePlanDto? _plan;
    bool _loading = true;
    bool _busy;

    // Drag and drop state
    Guid? _dragItemId;
    Guid? _dragSourceStageId;
    Guid? _dragStageId;
    Guid? _dragOverStageId;

    // Add-MR dialog
    bool _showAddMrModal;
    Guid _targetStageId;
    PagedResult<MrDto>? _availableMrs;
    string? _mrFilter = "";

    protected override async Task OnInitializedAsync()
    {
        // A null plan is a legitimate answer here (nothing generated yet), not a failure.
        await RunAsync(async () => _plan = await Api.GetActivePlanAsync());
        _loading = false;
    }

    async Task Recalculate()
    {
        _busy = true;
        await RunAsync(async () => _plan = await Api.RecalculatePlanAsync(), "Plan recalculated successfully.");
        _busy = false;
    }

    void NavigateToYaml() => Nav.NavigateTo(_plan is null ? "/plan/yaml" : $"/plan/yaml?id={_plan.Id}");

    void OnStageDragStart(Guid stageId) { _dragStageId = stageId; _dragItemId = null; }
    void OnItemDragStart(Guid itemId, Guid sourceStageId) { _dragItemId = itemId; _dragSourceStageId = sourceStageId; _dragStageId = null; }

    async Task OnDropToStage(Guid targetStageId)
    {
        _dragOverStageId = null;

        // Snapshot and clear before awaiting: a second drop landing mid-request would otherwise
        // read half-reset state.
        var itemId = _dragItemId;
        var stageId = _dragStageId;
        var sourceStageId = _dragSourceStageId;
        _dragItemId = null; _dragStageId = null; _dragSourceStageId = null;

        var plan = _plan;
        if (plan is null) return;

        if (itemId.HasValue && sourceStageId != targetStageId)
        {
            await RunAsync(async () => _plan = await Api.MoveItemAsync(plan.Id, itemId.Value, targetStageId), "Item moved.");
            return;
        }

        if (!stageId.HasValue || stageId == targetStageId) return;

        var stages = plan.Stages.OrderBy(s => s.Sequence).ToList();
        var fromIdx = stages.FindIndex(s => s.Id == stageId);
        var toIdx = stages.FindIndex(s => s.Id == targetStageId);
        if (fromIdx < 0 || toIdx < 0) return;

        var moved = stages[fromIdx];
        stages.RemoveAt(fromIdx);
        stages.Insert(toIdx, moved);

        var order = stages.Select(s => s.Id).ToList();
        await RunAsync(async () => _plan = await Api.ReorderStagesAsync(plan.Id, order), "Stages reordered.");
    }

    async Task RemoveItem(StageItemDto item)
    {
        var plan = _plan;
        if (plan is null) return;

        if (!await ConfirmAsync(
                "Remove from plan",
                $"Remove {item.RepositoryName} !{item.MrExternalId} from the release plan?")) return;

        await RunAsync(async () => _plan = await Api.RemoveItemAsync(plan.Id, item.Id), "Item removed.");
    }

    async Task OpenAddMrModal(Guid stageId)
    {
        _targetStageId = stageId;
        _showAddMrModal = true;
        _availableMrs = null;
        _mrFilter = "";

        await RunAsync(async () => _availableMrs = await Api.GetMergeRequestsAsync(pageSize: 200));
    }

    async Task AddMrToStage(Guid mrId)
    {
        var plan = _plan;
        if (plan is null) return;

        var stageId = _targetStageId;
        if (await RunAsync(async () => _plan = await Api.AddItemAsync(plan.Id, stageId, mrId), "MR added to stage."))
            _showAddMrModal = false;
    }

    IEnumerable<MrDto> FilteredMrs(PagedResult<MrDto> mrs) =>
        string.IsNullOrEmpty(_mrFilter)
            ? mrs.Items
            : mrs.Items.Where(m =>
                m.SourceBranch.Contains(_mrFilter, StringComparison.OrdinalIgnoreCase) ||
                m.RepositoryName.Contains(_mrFilter, StringComparison.OrdinalIgnoreCase));

    // Mirrors the server-side MergeRequestStatus enum, which the PWA does not reference.
    static FlareColor StatusColor(string status) => status switch
    {
        "ReadyForDeploy" => FlareColor.Success,
        "Merged" => FlareColor.Primary,
        "Opened" => FlareColor.Secondary,
        "Closed" => FlareColor.OnSurfaceVariant,
        _ => FlareColor.Default
    };
}
