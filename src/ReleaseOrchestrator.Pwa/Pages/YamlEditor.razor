@page "/plan/yaml"
@attribute [Authorize]
@inherits PageBase

<PageTitle>YAML Editor</PageTitle>

<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">YAML Release Plan</FlareText>
    <FlareSpacer />
    <FlareSwitch @bind-Value="_force" Label="Force import" />
    <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" OnClick="LoadExport" Disabled="_busy">
        Export Active
    </FlareButton>
    <FlareButton Size="ButtonSize.Sm" OnClick="ImportYaml"
                 Disabled="@(_busy || string.IsNullOrWhiteSpace(_yaml))">
        Import
    </FlareButton>
</FlareStack>

@* Force skips the hard-dependency check the server runs on import, so it can install a plan that
   contradicts the tracker. Saying so beside the switch is cheaper than explaining the outcome. *@
@if (_force)
{
    <FlareAlert Severity="AlertSeverity.Warning">
        Force skips validation against hard dependencies. The imported order may break them.
    </FlareAlert>
}

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (_busy)
{
    <FlareProgress Variant="ProgressVariant.Linear" />
}

<FlareTextArea @bind-Value="_yaml" Rows="30" Monospace
               Placeholder="Paste YAML here, or use 'Export Active' to load the current plan..." />

@code {
    [SupplyParameterFromQuery] Guid? Id { get; set; }

    string? _yaml = "";
    bool _busy;
    bool _force;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue) return;

        _busy = true;
        await RunAsync(async () => _yaml = await Api.ExportYamlAsync(Id.Value));
        _busy = false;
    }

    async Task LoadExport()
    {
        _busy = true;
        await RunAsync(async () =>
        {
            // Null here is "nothing generated yet" rather than a failure, so it needs its own notice.
            var plan = await Api.GetActivePlanAsync();
            if (plan is null)
            {
                Error = "No active plan found.";
                return;
            }
            _yaml = await Api.ExportYamlAsync(plan.Id);
        });
        _busy = false;
    }

    async Task ImportYaml()
    {
        _busy = true;
        await RunAsync(async () =>
        {
            var plan = await Api.ImportYamlAsync(_yaml ?? string.Empty, _force);
            Success = $"Plan '{plan.Name}' imported successfully.";
        });
        _busy = false;
    }
}
