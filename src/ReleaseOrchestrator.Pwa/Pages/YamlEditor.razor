@page "/plan/yaml"
@attribute [Authorize]
@inherits PageBase

<PageTitle>YAML Editor</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">YAML Release Plan</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-sm" @onclick="LoadExport" disabled="@_busy">Export Active</button>
        <button class="btn btn-success btn-sm" @onclick="ImportYaml" disabled="@(_busy || string.IsNullOrWhiteSpace(_yaml))">Import</button>
        <label class="form-check-label ms-2">
            <input type="checkbox" class="form-check-input me-1" @bind="_force" />
            Force import
        </label>
    </div>
</div>

<Alert Message="@Error" Type="danger" OnDismiss="@(() => Error = null)" />
<Alert Message="@Success" Type="success" OnDismiss="@(() => Success = null)" />

@if (_busy) { <Spinner /> }

<textarea class="form-control font-monospace" rows="30" @bind="_yaml" placeholder="Paste YAML here or click 'Export Active' to load the current plan..."></textarea>

@code {
    [SupplyParameterFromQuery] Guid? Id { get; set; }

    string _yaml = "";
    bool _busy;
    bool _force;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue) return;

        _busy = true;
        await RunAsync(async () => _yaml = await Api.ExportYamlAsync(Id.Value));
        _busy = false;
    }

    async Task LoadExport()
    {
        _busy = true;
        await RunAsync(async () =>
        {
            // Null here is "nothing generated yet" rather than a failure, so it needs its own notice.
            var plan = await Api.GetActivePlanAsync();
            if (plan is null)
            {
                Error = "No active plan found.";
                return;
            }
            _yaml = await Api.ExportYamlAsync(plan.Id);
        });
        _busy = false;
    }

    async Task ImportYaml()
    {
        _busy = true;
        await RunAsync(async () =>
        {
            var plan = await Api.ImportYamlAsync(_yaml, _force);
            Success = $"Plan '{plan.Name}' imported successfully.";
        });
        _busy = false;
    }
}
