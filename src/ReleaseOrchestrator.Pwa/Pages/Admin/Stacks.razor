@page "/admin/stacks"
@attribute [Authorize]
@inherits CrudPageBase<StackDto>

<PageTitle>Stacks</PageTitle>

<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">Stacks</FlareText>
    <FlareSpacer />
    <FlareButton Size="ButtonSize.Sm" OnClick="OpenCreate">
        <LeadingIcon><FlareIcon Name="@FlareIcons.Add" /></LeadingIcon>
        <ChildContent>New Stack</ChildContent>
    </FlareButton>
</FlareStack>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (Loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (Result is not null)
{
    <FlareStack Gap="FlareSpacing.Medium">
        @foreach (var stack in Result.Items)
        {
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@stack.Name">
                    <Action>
                        <FlareStack Row Gap="FlareSpacing.XSmall">
                            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined"
                                         OnClick="@(() => ToggleSection(stack.Id, "deps"))">Dependencies</FlareButton>
                            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined"
                                         OnClick="@(() => ToggleSection(stack.Id, "repos"))">Repositories</FlareButton>
                        </FlareStack>
                    </Action>
                </FlareCardHeader>

                @if (_expandedSection.TryGetValue(stack.Id, out var section) && section == "deps")
                {
                    <FlareCardContent>
                        <FlareText Typo="TypographyScale.TitleSmall">Add Dependency</FlareText>
                        <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End" StretchFirst>
                            <FlareSelect TValue="Guid?" Label="Target Stack" @bind-Value="_depTargetId"
                                         Items="@Result.Items.Where(s => s.Id != stack.Id).Select(s => (Guid?)s.Id)"
                                         ItemLabel="@(id => StackName(id))" />
                            <FlareSelect TValue="string" Label="Type" @bind-Value="_depType" Items="DependencyTypes" />
                            <FlareButton OnClick="@(() => AddDependency(stack.Id))"
                                         Disabled="@(_depTargetId is null)">Add</FlareButton>
                        </FlareStack>
                    </FlareCardContent>
                }

                @if (_expandedSection.TryGetValue(stack.Id, out var section2) && section2 == "repos")
                {
                    <FlareCardContent>
                        <FlareText Typo="TypographyScale.TitleSmall">Assign Repository</FlareText>
                        @if (_repositories is null)
                        {
                            <FlareProgress Variant="ProgressVariant.Circular" />
                        }
                        else
                        {
                            <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End" StretchFirst>
                                <FlareSelect TValue="Guid?" Label="Repository" @bind-Value="_repoId"
                                             Items="@_repositories.Items.Select(r => (Guid?)r.Id)"
                                             ItemLabel="@(id => RepositoryName(id))" />
                                <FlareButton OnClick="@(() => AssignRepo(stack.Id))"
                                             Disabled="@(_repoId is null)">Assign</FlareButton>
                            </FlareStack>
                        }
                    </FlareCardContent>
                }
            </FlareCard>
        }
    </FlareStack>

    @if (Result.Total > Result.PageSize)
    {
        <FlarePagination Current="Page" CurrentChanged="LoadPage" TotalPages="TotalPages"
                         TotalItems="Result.Total" PageSize="Result.PageSize" ShowInfo />
    }
}

<FlareDialog Visible="ShowModal" Title="New Stack" VisibleChanged="OnDialogVisibleChanged">
    <ChildContent>
        <FlareTextField Label="Stack Name" @bind-Value="_fName" />
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseModal">Cancel</FlareButton>
        <FlareButton OnClick="CreateStack" Loading="Saving"
                     Disabled="@(string.IsNullOrWhiteSpace(_fName))">Create</FlareButton>
    </Actions>
</FlareDialog>

@code {
    static readonly string[] DependencyTypes = ["Hard", "Soft"];

    PagedResult<RepositoryDto>? _repositories;

    string _fName = "";
    Guid? _depTargetId;
    string _depType = "Hard";
    Guid? _repoId;

    readonly Dictionary<Guid, string> _expandedSection = new();

    protected override Task<PagedResult<StackDto>> FetchPageAsync(int page) => Api.GetStacksAsync(page);

    void OpenCreate() { _fName = ""; ShowModal = true; }

    string StackName(Guid? id) => Result?.Items.FirstOrDefault(s => s.Id == id)?.Name ?? "";

    string RepositoryName(Guid? id)
    {
        var r = _repositories?.Items.FirstOrDefault(x => x.Id == id);
        return r is null ? "" : $"{r.Name} ({r.ConnectionName})";
    }

    Task CreateStack() => SaveAsync(() => Api.CreateStackAsync(_fName), "Stack created.");

    async Task ToggleSection(Guid stackId, string section)
    {
        if (_expandedSection.TryGetValue(stackId, out var current) && current == section)
        {
            _expandedSection.Remove(stackId);
            return;
        }
        _expandedSection[stackId] = section;

        if (section != "repos" || _repositories is not null) return;

        await RunAsync(async () => _repositories = await Api.GetRepositoriesAsync());
    }

    async Task AddDependency(Guid fromStackId)
    {
        if (_depTargetId is not { } toStackId) return;

        if (await RunAsync(() => Api.AddStackDependencyAsync(fromStackId, toStackId, _depType), "Dependency added."))
            _depTargetId = null;
    }

    async Task AssignRepo(Guid stackId)
    {
        if (_repoId is not { } repositoryId) return;

        if (await RunAsync(() => Api.AssignRepositoryToStackAsync(stackId, repositoryId), "Repository assigned."))
            _repoId = null;
    }
}
