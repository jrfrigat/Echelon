@page "/admin/stacks"
@attribute [Authorize]
@inherits CrudPageBase<StackDto>

<PageTitle>Stacks</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Stacks</h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Stack</button>
</div>

<Alert Message="@Error" Type="danger" OnDismiss="@(() => Error = null)" />
<Alert Message="@Success" Type="success" OnDismiss="@(() => Success = null)" />

@if (Loading) { <Spinner /> }
else if (Result is not null)
{
    @foreach (var stack in Result.Items)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <strong>@stack.Name</strong>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => ToggleSection(stack.Id, "deps"))">Dependencies</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => ToggleSection(stack.Id, "repos"))">Repositories</button>
                </div>
            </div>

            @if (_expandedSection.TryGetValue(stack.Id, out var section) && section == "deps")
            {
                <div class="card-body border-top p-3">
                    <h6 class="mb-2">Add Dependency</h6>
                    <div class="d-flex gap-2 align-items-end">
                        <div class="flex-grow-1">
                            <label class="form-label small">Target Stack</label>
                            <select class="form-select form-select-sm" @bind="_depTargetId">
                                <option value="">-- Select stack --</option>
                                @foreach (var s in Result.Items.Where(s => s.Id != stack.Id))
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label small">Type</label>
                            <select class="form-select form-select-sm" @bind="_depType">
                                <option value="Hard">Hard</option>
                                <option value="Soft">Soft</option>
                            </select>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => AddDependency(stack.Id))"
                                disabled="@(string.IsNullOrEmpty(_depTargetId))">Add</button>
                    </div>
                </div>
            }

            @if (_expandedSection.TryGetValue(stack.Id, out var section2) && section2 == "repos")
            {
                <div class="card-body border-top p-3">
                    <h6 class="mb-2">Assign Repository</h6>
                    @if (_repositories is null)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <div class="d-flex gap-2 align-items-end">
                            <div class="flex-grow-1">
                                <label class="form-label small">Repository</label>
                                <select class="form-select form-select-sm" @bind="_repoId">
                                    <option value="">-- Select repository --</option>
                                    @foreach (var r in _repositories.Items)
                                    {
                                        <option value="@r.Id">@r.Name (@r.ConnectionName)</option>
                                    }
                                </select>
                            </div>
                            <button class="btn btn-primary btn-sm" @onclick="@(() => AssignRepo(stack.Id))"
                                    disabled="@(string.IsNullOrEmpty(_repoId))">Assign</button>
                        </div>
                    }
                </div>
            }
        </div>
    }
    <Pager Result="Result" Page="Page" OnPageChange="LoadPage" />
}

<ModalDialog Visible="ShowModal"
             Title="New Stack"
             OnClose="CloseModal"
             OnSave="CreateStack"
             Saving="Saving"
             SaveDisabled="@(string.IsNullOrWhiteSpace(_fName))"
             SaveText="Create">
    <div class="mb-3">
        <label class="form-label">Stack Name</label>
        <input class="form-control" @bind="_fName" />
    </div>
</ModalDialog>

@code {
    PagedResult<RepositoryDto>? _repositories;

    string _fName = "";
    string _depTargetId = "";
    string _depType = "Hard";
    string _repoId = "";

    readonly Dictionary<Guid, string> _expandedSection = new();

    protected override Task<PagedResult<StackDto>> FetchPageAsync(int page) => Api.GetStacksAsync(page);

    void OpenCreate() { _fName = ""; ShowModal = true; }
    void CloseModal() => ShowModal = false;

    Task CreateStack() => SaveAsync(() => Api.CreateStackAsync(_fName), "Stack created.");

    async Task ToggleSection(Guid stackId, string section)
    {
        if (_expandedSection.TryGetValue(stackId, out var current) && current == section)
        {
            _expandedSection.Remove(stackId);
            return;
        }
        _expandedSection[stackId] = section;

        if (section != "repos" || _repositories is not null) return;

        await RunAsync(async () => _repositories = await Api.GetRepositoriesAsync());
    }

    async Task AddDependency(Guid fromStackId)
    {
        if (!Guid.TryParse(_depTargetId, out var toStackId)) return;

        if (await RunAsync(() => Api.AddStackDependencyAsync(fromStackId, toStackId, _depType), "Dependency added."))
            _depTargetId = "";
    }

    async Task AssignRepo(Guid stackId)
    {
        if (!Guid.TryParse(_repoId, out var repositoryId)) return;

        if (await RunAsync(() => Api.AssignRepositoryToStackAsync(stackId, repositoryId), "Repository assigned."))
            _repoId = "";
    }
}
