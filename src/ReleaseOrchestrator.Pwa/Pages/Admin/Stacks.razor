@page "/admin/stacks"
@attribute [Authorize]
@inject ApiService Api

<PageTitle>Stacks</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Stacks</h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Stack</button>
</div>

<Alert Message="@_error" Type="danger" OnDismiss="@(() => _error = null)" />
<Alert Message="@_success" Type="success" OnDismiss="@(() => _success = null)" />

@if (_loading) { <Spinner /> }
else if (_result is not null)
{
    @foreach (var stack in _result.Items)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <strong>@stack.Name</strong>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => ToggleSection(stack.Id, "deps"))">Dependencies</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => ToggleSection(stack.Id, "repos"))">Repositories</button>
                </div>
            </div>

            @if (_expandedSection.TryGetValue(stack.Id, out var section) && section == "deps")
            {
                <div class="card-body border-top p-3">
                    <h6 class="mb-2">Add Dependency</h6>
                    <div class="d-flex gap-2 align-items-end">
                        <div class="flex-grow-1">
                            <label class="form-label small">Target Stack</label>
                            <select class="form-select form-select-sm" @bind="_depTargetId">
                                <option value="">-- Select stack --</option>
                                @foreach (var s in _result.Items.Where(s => s.Id != stack.Id))
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label small">Type</label>
                            <select class="form-select form-select-sm" @bind="_depType">
                                <option value="Hard">Hard</option>
                                <option value="Soft">Soft</option>
                            </select>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => AddDependency(stack.Id))" disabled="@(string.IsNullOrEmpty(_depTargetId))">Add</button>
                    </div>
                </div>
            }

            @if (_expandedSection.TryGetValue(stack.Id, out var section2) && section2 == "repos")
            {
                <div class="card-body border-top p-3">
                    <h6 class="mb-2">Assign Repository</h6>
                    @if (_repositories is null)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <div class="d-flex gap-2 align-items-end">
                            <div class="flex-grow-1">
                                <label class="form-label small">Repository</label>
                                <select class="form-select form-select-sm" @bind="_repoId">
                                    <option value="">-- Select repository --</option>
                                    @foreach (var r in _repositories.Items)
                                    {
                                        <option value="@r.Id">@r.Name (@r.ConnectionName)</option>
                                    }
                                </select>
                            </div>
                            <button class="btn btn-primary btn-sm" @onclick="@(() => AssignRepo(stack.Id))" disabled="@(string.IsNullOrEmpty(_repoId))">Assign</button>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (_result.Total > _result.PageSize)
    {
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Showing @_result.Items.Count of @_result.Total</small>
            <div>
                <button class="btn btn-outline-secondary btn-sm me-1" disabled="@(_page == 1)" @onclick="@(() => LoadPage(_page - 1))">Prev</button>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(_page * _result.PageSize >= _result.Total)" @onclick="@(() => LoadPage(_page + 1))">Next</button>
            </div>
        </div>
    }
}

@if (_showCreateModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Stack</h5>
                    <button class="btn-close" @onclick="@(() => _showCreateModal = false)"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Stack Name</label><input class="form-control" @bind="_fName" /></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="@(() => _showCreateModal = false)">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateStack" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Create
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    PagedResult<StackDto>? _result;
    PagedResult<RepositoryDto>? _repositories;
    bool _loading = true;
    bool _showCreateModal, _saving;
    string? _error, _success;
    int _page = 1;

    string _fName = "";
    string _depTargetId = "";
    string _depType = "Hard";
    string _repoId = "";

    Dictionary<Guid, string> _expandedSection = new();

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    async Task LoadPage(int page)
    {
        _page = page; _loading = true;
        try { _result = await Api.GetStacksAsync(page); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    void OpenCreate() { _fName = ""; _showCreateModal = true; }

    async Task CreateStack()
    {
        _saving = true; _error = null;
        try
        {
            var ok = await Api.CreateStackAsync(_fName);
            if (ok) { _showCreateModal = false; _success = "Stack created."; await LoadPage(_page); }
            else _error = "Create failed.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    async Task ToggleSection(Guid stackId, string section)
    {
        if (_expandedSection.TryGetValue(stackId, out var current) && current == section)
        {
            _expandedSection.Remove(stackId);
            return;
        }
        _expandedSection[stackId] = section;

        if (section == "repos" && _repositories is null)
        {
            try { _repositories = await Api.GetRepositoriesAsync(); }
            catch (Exception ex) { _error = ex.Message; }
        }
    }

    async Task AddDependency(Guid fromStackId)
    {
        if (!Guid.TryParse(_depTargetId, out var toStackId)) return;
        _error = null;
        try
        {
            var ok = await Api.AddStackDependencyAsync(fromStackId, toStackId, _depType);
            if (ok) { _success = "Dependency added."; _depTargetId = ""; }
            else _error = "Failed to add dependency.";
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    async Task AssignRepo(Guid stackId)
    {
        if (!Guid.TryParse(_repoId, out var repositoryId)) return;
        _error = null;
        try
        {
            var ok = await Api.AssignRepositoryToStackAsync(stackId, repositoryId);
            if (ok) { _success = "Repository assigned."; _repoId = ""; }
            else _error = "Failed to assign repository.";
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
