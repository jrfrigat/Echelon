@page "/admin/readiness-rules"
@attribute [Authorize]
@inherits PageBase

<PageTitle>@UiStrings.RR_Title</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.RR_Heading" />

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            @* A real form so Enter in any field adds the rule. Every add-form in this app was a bare
               stack of inputs, which is why Enter did nothing anywhere and the button always had to
               be found with the mouse. *@
            <form @onsubmit="Create" @onsubmit:preventDefault>
                @* Align Start, not End. Every field puts its label above the input, so aligning the
                   tops lines the inputs up; aligning the bottoms lined up the helper text instead and
                   pushed the one field that has any a row higher than its neighbours. The button is
                   nudged down by the label height so it still sits on the input line. *@
                <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Start" Wrap>
                    <FlareTextField Label="@UiStrings.Common_Name" @bind-Value="_name" Style="min-width:12rem;" />
                    <FlareSelect TValue="string" Label="@UiStrings.RR_Mode_Label"
                                 @bind-Value="_mode" Items="Modes" ItemLabel="@(ModeLabel)" Style="min-width:10rem;" />
                    <FlareTextField Label="@UiStrings.RR_Signals_Label" @bind-Value="_signals"
                                    Style="min-width:22rem;" />
                    <div style="margin-top:1.5rem;">
                        <FlareButton Type="ButtonType.Submit" Loading="_busy"
                                     Disabled="@(string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_signals))">@UiStrings.RR_Add</FlareButton>
                    </div>
                </FlareStack>
            </form>

            @* Outside the form on purpose: a chip renders as a button, and a button inside a form
               with no explicit type submits it — so clicking a signal to add it would have created
               the rule instead. It edits the field above rather than being a control of the form.

               The hint moved out of HelperText and under the row too: as a per-field helper it was
               what made the row uneven, and it describes the vocabulary, not that one input. *@
            <SignalPicker Value="_signals" ValueChanged="@(v => _signals = v)" />
        </FlareCardContent>
    </FlareCard>

    @if (_loading)
    {
        <FlareProgress Variant="ProgressVariant.Circular" />
    }
    else if (_rules is null || _rules.Count == 0)
    {
        <FlareEmptyState Title="@UiStrings.RR_Empty_Title" Description="@UiStrings.RR_Empty_Description" />
    }
    else
    {
        <FlareDataGrid TItem="ReadinessRuleDto" Items="_rules" Dense="true" Striped="true" Hoverable="true" ShowPager="false">
            <Columns>
                <FlareColumn TItem="ReadinessRuleDto" Id="name" Title="@UiStrings.Common_Name"
                             Field="@(r => (object?)r.Name)" Sortable="true" Filterable="true" />
                <FlareColumn TItem="ReadinessRuleDto" Id="mode" Title="@UiStrings.RR_Col_Mode">
                    <Template>
                        <FlareChip Size="ChipSize.Sm" Color="FlareColor.Primary" Label="@ModeLabel(context.Mode)" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="ReadinessRuleDto" Id="signals" Title="@UiStrings.RR_Col_Signals">
                    <Template>
                        <FlareStack Row Gap="FlareSpacing.XSmall" Wrap>
                            @foreach (var s in context.RequiredSignals)
                            {
                                <FlareCode>@s</FlareCode>
                            }
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="ReadinessRuleDto" Id="actions" Title="" Align="ColumnAlign.End">
                    <Template>
                        <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                            <FlareIconButton Size="ButtonSize.Sm"
                                             AriaLabel="@string.Format(UiStrings.Common_Edit_Aria, context.Name)"
                                             OnClick="@(() => OpenEdit(context))">
                                <FlareIconView Value="MaterialDesign3Icons.Regular.Edit" />
                            </FlareIconButton>
                            <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                             AriaLabel="@string.Format(UiStrings.Common_Delete_Aria, context.Name)"
                                             OnClick="@(() => Delete(context))">
                                <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                            </FlareIconButton>
                        </FlareStack>
                    </Template>
                </FlareColumn>
            </Columns>
        </FlareDataGrid>
    }
</FlareStack>

<FlareDialog Visible="_showEdit" Title="@UiStrings.RR_Dialog_Edit" VisibleChanged="@(v => _showEdit = v)">
    <ChildContent>
        @* A form so Enter saves; the dialog's Save button lives in a separate fragment, so the hidden
           submit is what Enter actually triggers. The picker stays outside it — its chips are buttons,
           and a button in a form with no explicit type submits it, so clicking a signal would save. *@
        <form @onsubmit="SaveEdit" @onsubmit:preventDefault>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareTextField Label="@UiStrings.Common_Name" @bind-Value="_eName" />
                <FlareSelect TValue="string" Label="@UiStrings.RR_Mode_Label"
                             @bind-Value="_eMode" Items="Modes" ItemLabel="@(ModeLabel)" />
                <FlareTextField Label="@UiStrings.RR_Signals_Label" @bind-Value="_eSignals" />
            </FlareStack>
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
        </form>
        <SignalPicker Value="_eSignals" ValueChanged="@(v => _eSignals = v)" />
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => _showEdit = false)">@UiStrings.Common_Cancel</FlareButton>
        <FlareButton OnClick="SaveEdit" Loading="_busy"
                     Disabled="@(string.IsNullOrWhiteSpace(_eName) || string.IsNullOrWhiteSpace(_eSignals))">@UiStrings.Common_Save</FlareButton>
    </Actions>
</FlareDialog>

@code {
    // Mirrors the gating modes a named rule may take (ReadyRule minus NoGate); the PWA does not reference Core.
    static readonly string[] Modes = ["AllOf", "AnyOf"];

    List<ReadinessRuleDto>? _rules;
    bool _loading = true;
    bool _busy;

    string _name = "";
    string _mode = "AllOf";
    string _signals = "";

    bool _showEdit;
    Guid _eId;
    string _eName = "";
    string _eMode = "AllOf";
    string _eSignals = "";

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        await RunAsync(async () => _rules = await Api.GetReadinessRulesAsync());
        _loading = false;
    }

    async Task Create()
    {
        // Enter and the button are the same path now, and a keypress does not consult the button's
        // disabled state — so both the guard and the emptiness check have to be here.
        if (_busy || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_signals)) return;

        _busy = true;
        if (await RunAsync(
                async () => await Api.CreateReadinessRuleAsync(_name.Trim(), _mode, SplitSignals(_signals)),
                UiStrings.RR_Created))
        {
            _name = ""; _mode = "AllOf"; _signals = "";
            await Load();
        }
        _busy = false;
    }

    void OpenEdit(ReadinessRuleDto rule)
    {
        _eId = rule.Id;
        _eName = rule.Name;
        _eMode = rule.Mode;
        _eSignals = string.Join(" ", rule.RequiredSignals);
        _showEdit = true;
    }

    async Task SaveEdit()
    {
        // Enter submits too, and does not consult the Save button's disabled state.
        if (_busy || string.IsNullOrWhiteSpace(_eName) || string.IsNullOrWhiteSpace(_eSignals)) return;

        _busy = true;
        if (await RunAsync(
                async () => await Api.UpdateReadinessRuleAsync(_eId, _eName.Trim(), _eMode, SplitSignals(_eSignals)),
                UiStrings.RR_Updated))
        {
            _showEdit = false;
            await Load();
        }
        _busy = false;
    }

    async Task Delete(ReadinessRuleDto rule)
    {
        if (!await ConfirmAsync(UiStrings.RR_Delete_Title, string.Format(UiStrings.RR_Delete_Message, rule.Name))) return;
        if (await RunAsync(async () => await Api.DeleteReadinessRuleAsync(rule.Id), UiStrings.RR_Deleted))
            await Load();
    }

    /// <summary>Splits the signals field on commas and whitespace; the server canonicalizes them.</summary>
    static List<string> SplitSignals(string text) =>
        text.Split([',', ' ', '\t', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries).ToList();

    static string ModeLabel(string mode) => mode switch
    {
        "AnyOf" => UiStrings.Env_Rule_AnyOf,
        _ => UiStrings.Env_Rule_AllOf
    };
}
