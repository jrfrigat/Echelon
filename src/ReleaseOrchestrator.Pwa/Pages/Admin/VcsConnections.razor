@page "/admin/vcs"
@attribute [Authorize]
@inherits CrudPageBase<VcsConnectionDto>

<PageTitle>VCS Connections</PageTitle>

<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">VCS Connections</FlareText>
    <FlareSpacer />
    <FlareButton Size="ButtonSize.Sm" OnClick="OpenCreate">
        <LeadingIcon><FlareIcon Name="@FlareIcons.Add" /></LeadingIcon>
        <ChildContent>New Connection</ChildContent>
    </FlareButton>
</FlareStack>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (Loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (Result is not null)
{
    <FlareDataGrid TItem="VcsConnectionDto" Items="Result.Items" ShowPager="false">
        <Columns>
            <FlareColumn TItem="VcsConnectionDto" Title="Name" Field="@(c => c.Name)" />
            <FlareColumn TItem="VcsConnectionDto" Title="Type">
                <Template>
                    <FlareChip Label="@context.VcsType" Size="ChipSize.Sm" />
                </Template>
            </FlareColumn>
            <FlareColumn TItem="VcsConnectionDto" Title="API URL" Field="@(c => c.ApiUrl)" />
            <FlareColumn TItem="VcsConnectionDto" Title="Ready-for-deploy label">
                <Template>
                    @if (string.IsNullOrWhiteSpace(context.ReadyForDeployLabel))
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Secondary">disabled</FlareText>
                    }
                    else
                    {
                        <FlareCode>@context.ReadyForDeployLabel</FlareCode>
                    }
                </Template>
            </FlareColumn>
            <FlareColumn TItem="VcsConnectionDto" Title="" Align="ColumnAlign.End">
                <Template>
                    <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                        <FlareIconButton AriaLabel="@($"Edit {context.Name}")" OnClick="@(() => OpenEdit(context))">
                            <FlareIcon Name="@FlareIcons.Edit" />
                        </FlareIconButton>
                        <FlareIconButton AriaLabel="@($"Delete {context.Name}")" Color="FlareColor.Error" OnClick="@(() => Delete(context))">
                            <FlareIcon Name="@FlareIcons.Delete" />
                        </FlareIconButton>
                    </FlareStack>
                </Template>
            </FlareColumn>
        </Columns>
    </FlareDataGrid>

    @if (Result.Total > Result.PageSize)
    {
        <FlarePagination Current="Page" CurrentChanged="LoadPage" TotalPages="TotalPages"
                         TotalItems="Result.Total" PageSize="Result.PageSize" ShowInfo />
    }
}

<FlareDialog Visible="ShowModal"
             Title="@(_editId.HasValue ? "Edit VCS Connection" : "New VCS Connection")"
             VisibleChanged="OnDialogVisibleChanged">
    <ChildContent>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareTextField Label="Name" @bind-Value="_fName" />
            @if (!_editId.HasValue)
            {
                <FlareSelect TValue="string" Label="Type" @bind-Value="_fType" Items="VcsTypes" />
            }
            <FlareTextField Label="API URL" @bind-Value="_fUrl" Placeholder="https://gitlab.example.com" />
            <FlareTextField Label="Ready-for-deploy label" @bind-Value="_fLabel"
                            Placeholder="@DefaultReadyForDeployLabel"
                            HelperText="@($"Merge requests carrying this {_fType} label are picked up into the release plan automatically. Leave blank to turn that off — merge requests from this connection will then only enter a plan when added by hand.")" />
            <FlarePasswordField Label="@($"Access Token{(_editId.HasValue ? " (leave blank to keep current)" : "")}")"
                                @bind-Value="_fToken" />
        </FlareStack>
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseModal">Cancel</FlareButton>
        <FlareButton OnClick="Save" Loading="Saving" Disabled="IsFormIncomplete">Save</FlareButton>
    </Actions>
</FlareDialog>

@code {
    // Mirrors VcsConnection.DefaultReadyForDeployLabel; the PWA does not reference Core.
    const string DefaultReadyForDeployLabel = "ready-for-deploy";

    static readonly string[] VcsTypes = ["GitLab"];

    Guid? _editId;
    string _fName = "", _fType = "GitLab", _fUrl = "", _fToken = "", _fLabel = "";

    // The type is fixed at creation: an existing connection's stored repositories and token are
    // meaningless against a different provider, so Update takes no vcsType.
    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fUrl)
                             || (!_editId.HasValue && string.IsNullOrWhiteSpace(_fToken));

    protected override Task<PagedResult<VcsConnectionDto>> FetchPageAsync(int page) =>
        Api.GetVcsConnectionsAsync(page);

    void OpenCreate()
    {
        _editId = null;
        _fName = ""; _fType = "GitLab"; _fUrl = ""; _fToken = "";
        _fLabel = DefaultReadyForDeployLabel;
        ShowModal = true;
    }

    void OpenEdit(VcsConnectionDto c)
    {
        _editId = c.Id;
        _fName = c.Name; _fType = c.VcsType; _fUrl = c.ApiUrl;
        _fLabel = c.ReadyForDeployLabel ?? "";
        _fToken = "";
        ShowModal = true;
    }

    Task Save() => SaveAsync(async () =>
    {
        // Blank label means "no label-driven promotion", which the API expresses as null.
        var label = string.IsNullOrWhiteSpace(_fLabel) ? null : _fLabel.Trim();

        if (_editId.HasValue)
            await Api.UpdateVcsConnectionAsync(_editId.Value, _fName, _fUrl, _fToken, label);
        else
            await Api.CreateVcsConnectionAsync(_fName, _fType, _fUrl, _fToken, label);
    });

    Task Delete(VcsConnectionDto c) =>
        DeleteAsync($"VCS connection '{c.Name}'", () => Api.DeleteVcsConnectionAsync(c.Id));
}
