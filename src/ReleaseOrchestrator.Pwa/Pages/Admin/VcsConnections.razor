@page "/admin/vcs"
@attribute [Authorize]
@inherits CrudPageBase<VcsConnectionDto>

<PageTitle>VCS Connections</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">VCS Connections</h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Connection</button>
</div>

<Alert Message="@Error" Type="danger" OnDismiss="@(() => Error = null)" />
<Alert Message="@Success" Type="success" OnDismiss="@(() => Success = null)" />

@if (Loading) { <Spinner /> }
else if (Result is not null)
{
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>Type</th><th>API URL</th><th>Ready-for-deploy label</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Result.Items)
        {
            <tr>
                <td>@c.Name</td>
                <td><span class="badge bg-secondary">@c.VcsType</span></td>
                <td class="text-muted small">@c.ApiUrl</td>
                <td class="small">
                    @if (string.IsNullOrWhiteSpace(c.ReadyForDeployLabel))
                    {
                        <span class="text-muted fst-italic">disabled</span>
                    }
                    else
                    {
                        <code>@c.ReadyForDeployLabel</code>
                    }
                </td>
                <td class="text-end">
                    <button class="btn btn-outline-secondary btn-sm me-1" @onclick="@(() => OpenEdit(c))">Edit</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="@(() => Delete(c))">Delete</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <Pager Result="Result" Page="Page" OnPageChange="LoadPage" />
}

<ModalDialog Visible="ShowModal"
             Title="@(_editId.HasValue ? "Edit VCS Connection" : "New VCS Connection")"
             OnClose="CloseModal"
             OnSave="Save"
             Saving="Saving"
             SaveDisabled="@IsFormIncomplete">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" @bind="_fName" />
    </div>
    @if (!_editId.HasValue)
    {
        <div class="mb-3">
            <label class="form-label">Type</label>
            <select class="form-select" @bind="_fType">
                <option value="GitLab">GitLab</option>
            </select>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">API URL</label>
        <input class="form-control" @bind="_fUrl" placeholder="https://gitlab.example.com" />
    </div>
    <div class="mb-3">
        <label class="form-label">Ready-for-deploy label</label>
        <input class="form-control" @bind="_fLabel" placeholder="@DefaultReadyForDeployLabel" />
        <div class="form-text">
            Merge requests carrying this @(_fType) label are picked up into the release plan automatically.
            Leave blank to turn that off — merge requests from this connection will then only enter a plan
            when added by hand.
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Access Token @(_editId.HasValue ? "(leave blank to keep current)" : "")</label>
        <input class="form-control" type="password" @bind="_fToken" />
    </div>
</ModalDialog>

@code {
    // Mirrors VcsConnection.DefaultReadyForDeployLabel; the PWA does not reference Core.
    const string DefaultReadyForDeployLabel = "ready-for-deploy";

    Guid? _editId;
    string _fName = "", _fType = "GitLab", _fUrl = "", _fToken = "", _fLabel = "";

    // The type is fixed at creation: an existing connection's stored repositories and token are
    // meaningless against a different provider, so Update takes no vcsType.
    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fUrl)
                             || (!_editId.HasValue && string.IsNullOrWhiteSpace(_fToken));

    protected override Task<PagedResult<VcsConnectionDto>> FetchPageAsync(int page) =>
        Api.GetVcsConnectionsAsync(page);

    void OpenCreate()
    {
        _editId = null;
        _fName = ""; _fType = "GitLab"; _fUrl = ""; _fToken = "";
        _fLabel = DefaultReadyForDeployLabel;
        ShowModal = true;
    }

    void OpenEdit(VcsConnectionDto c)
    {
        _editId = c.Id;
        _fName = c.Name; _fType = c.VcsType; _fUrl = c.ApiUrl;
        _fLabel = c.ReadyForDeployLabel ?? "";
        _fToken = "";
        ShowModal = true;
    }

    void CloseModal() => ShowModal = false;

    Task Save() => SaveAsync(async () =>
    {
        // Blank label means "no label-driven promotion", which the API expresses as null.
        var label = string.IsNullOrWhiteSpace(_fLabel) ? null : _fLabel.Trim();

        if (_editId.HasValue)
            await Api.UpdateVcsConnectionAsync(_editId.Value, _fName, _fUrl, _fToken, label);
        else
            await Api.CreateVcsConnectionAsync(_fName, _fType, _fUrl, _fToken, label);
    });

    Task Delete(VcsConnectionDto c) =>
        DeleteAsync($"VCS connection '{c.Name}'", () => Api.DeleteVcsConnectionAsync(c.Id));
}
