@page "/admin/deploy-targets"
@attribute [Authorize]
@inherits PageBase

<PageTitle>@UiStrings.Deploy_Title</PageTitle>

<FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">@UiStrings.Deploy_Heading</FlareText>
<FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Secondary">@UiStrings.Deploy_Intro</FlareText>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (_repos is { Count: 0 } || _envs is { Count: 0 } || _strategies is { Count: 0 })
{
    <FlareEmptyState Title="@UiStrings.Deploy_Prereq_Title" Description="@UiStrings.Deploy_Prereq_Description" />
}
else
{
    <FlareCard>
        <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Small">
                <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End" Wrap>
                    <FlareSelect TValue="Guid?" Label="@UiStrings.Deploy_Col_Repository"
                                 @bind-Value="_repoId" Items="RepoOptions"
                                 ItemLabel="@(id => _repos!.FirstOrDefault(r => r.Id == id)?.Name ?? "-")"
                                 Style="min-width:12rem;" />
                    <FlareSelect TValue="Guid?" Label="@UiStrings.Deploy_Col_Environment"
                                 @bind-Value="_envId" Items="EnvOptions"
                                 ItemLabel="@(id => _envs!.FirstOrDefault(e => e.Id == id)?.Key ?? "-")"
                                 Style="min-width:10rem;" />
                    <FlareSelect TValue="string" Label="@UiStrings.Deploy_Col_Strategy"
                                 Value="_strategyKey" ValueChanged="OnStrategyChanged"
                                 Items="StrategyOptions" Style="min-width:12rem;" />
                    <FlareSelect TValue="string" Label="@UiStrings.Deploy_Col_Redeploy"
                                 @bind-Value="_redeployPolicy" Items="RedeployPolicies"
                                 ItemLabel="@(p => RedeployLabel(p))" Style="min-width:10rem;" />
                </FlareStack>

                @* Whatever the selected strategy declared, rendered from its schema. *@
                <ProviderSettingsFields Schema="SelectedSchema" Values="_settings" OnChanged="StateHasChanged" />

                <FlareStack Row>
                    <FlareButton OnClick="Add" Loading="_busy" Disabled="IsIncomplete">@UiStrings.Deploy_Add</FlareButton>
                </FlareStack>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>
}

@if (_loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (_targets is null || _targets.Count == 0)
{
    <FlareEmptyState Title="@UiStrings.Deploy_Empty_Title" Description="@UiStrings.Deploy_Empty_Description" />
}
else
{
    <FlareDataGrid TItem="DeployTargetDto" Items="_targets" Dense="true" Striped="true" Hoverable="true" ShowPager="false">
        <Columns>
            <FlareColumn TItem="DeployTargetDto" Id="repo" Title="@UiStrings.Deploy_Col_Repository"
                         Field="@(t => (object?)t.RepositoryName)" Sortable="true" Filterable="true" />
            <FlareColumn TItem="DeployTargetDto" Id="env" Title="@UiStrings.Deploy_Col_Environment"
                         Field="@(t => (object?)t.EnvironmentKey)" Sortable="true" Filterable="true" />
            <FlareColumn TItem="DeployTargetDto" Id="strategy" Title="@UiStrings.Deploy_Col_Strategy">
                <Template><FlareCode>@context.DeployStrategyKey</FlareCode></Template>
            </FlareColumn>
            <FlareColumn TItem="DeployTargetDto" Id="redeploy" Title="@UiStrings.Deploy_Col_Redeploy">
                <Template>
                    <FlareChip Size="ChipSize.Sm"
                               Color="@(context.RedeployPolicy == "Always" ? FlareColor.Warning : FlareColor.Default)">
                        @RedeployLabel(context.RedeployPolicy)
                    </FlareChip>
                </Template>
            </FlareColumn>
            <FlareColumn TItem="DeployTargetDto" Id="actions" Title="" Align="ColumnAlign.End">
                <Template>
                    <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                     AriaLabel="@string.Format(UiStrings.Common_Delete_Aria, context.RepositoryName)"
                                     OnClick="@(() => Delete(context))">
                        <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                    </FlareIconButton>
                </Template>
            </FlareColumn>
        </Columns>
    </FlareDataGrid>
}

@code {
    // Mirrors Core.Enums.RedeployPolicy; the PWA does not reference Core.
    static readonly string[] RedeployPolicies = ["Once", "Always", "Inherit"];

    List<RepositoryDto>? _repos;
    List<EnvironmentDto>? _envs;
    List<ProviderTypeDto>? _strategies;
    List<DeployTargetDto>? _targets;
    bool _loading = true;
    bool _busy;

    Guid? _repoId;
    Guid? _envId;
    string _strategyKey = "";
    string _redeployPolicy = "Once";
    Dictionary<string, string> _settings = [];

    IEnumerable<Guid?> RepoOptions => _repos?.Select(r => (Guid?)r.Id) ?? [];
    IEnumerable<Guid?> EnvOptions => _envs?.Select(e => (Guid?)e.Id) ?? [];
    IEnumerable<string> StrategyOptions => _strategies?.Select(s => s.ProviderType) ?? [];

    IReadOnlyList<ProviderSettingDto> SelectedSchema =>
        _strategies?.FirstOrDefault(s => s.ProviderType == _strategyKey)?.Settings ?? [];

    bool IsIncomplete => _repoId is null || _envId is null || string.IsNullOrWhiteSpace(_strategyKey)
                         || ProviderSettingsFields.MissingRequired(SelectedSchema, _settings, editing: false);

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () =>
        {
            _repos = (await Api.GetRepositoriesAsync()).Items;
            _envs = await Api.GetEnvironmentsAsync();
            _strategies = await Api.GetDeployStrategiesAsync();
            _targets = await Api.GetDeployTargetsAsync();
        });
        _repoId = RepoOptions.FirstOrDefault();
        _envId = EnvOptions.FirstOrDefault();
        _strategyKey = StrategyOptions.FirstOrDefault() ?? "";
        _settings = ProviderSettingsFields.Blank(SelectedSchema);
        _loading = false;
    }

    void OnStrategyChanged(string value)
    {
        _strategyKey = value;
        _settings = ProviderSettingsFields.Blank(SelectedSchema);
    }

    async Task Add()
    {
        _busy = true;
        var settings = ProviderSettingsFields.ForSubmit(_settings);
        if (await RunAsync(
                async () => await Api.CreateDeployTargetAsync(
                    _repoId!.Value, _envId!.Value, _strategyKey, _redeployPolicy, settings),
                UiStrings.Deploy_Created))
        {
            _settings = ProviderSettingsFields.Blank(SelectedSchema);
            await Reload();
        }
        _busy = false;
    }

    async Task Delete(DeployTargetDto target)
    {
        if (!await ConfirmAsync(UiStrings.Deploy_Delete_Title,
                string.Format(UiStrings.Deploy_Delete_Message, target.RepositoryName, target.EnvironmentKey))) return;
        if (await RunAsync(async () => await Api.DeleteDeployTargetAsync(target.Id), UiStrings.Deploy_Deleted))
            await Reload();
    }

    async Task Reload() => await RunAsync(async () => _targets = await Api.GetDeployTargetsAsync());

    static string RedeployLabel(string policy) => policy switch
    {
        "Always" => UiStrings.Deploy_Redeploy_Always,
        "Inherit" => UiStrings.Deploy_Redeploy_Inherit,
        _ => UiStrings.Deploy_Redeploy_Once
    };
}
