@page "/admin/trackers"
@attribute [Authorize]
@inherits CrudPageBase<TrackerConnectionDto>

<PageTitle>@UiStrings.Tracker_Title</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.Tracker_Title">
        <Actions>
            <FlareButton Size="ButtonSize.Sm" OnClick="OpenCreate">
                <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                <ChildContent>@UiStrings.Tracker_New</ChildContent>
            </FlareButton>
        </Actions>
    </PageHeader>

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    @if (Loading)
    {
        <FlareProgress Variant="ProgressVariant.Circular" />
    }
    else if (Result is not null)
    {
        <FlareDataGrid TItem="TrackerConnectionDto" Items="Result.Items" ShowPager="false">
            <Columns>
                <FlareColumn TItem="TrackerConnectionDto" Title="@UiStrings.Common_Name" Field="@(c => c.Name)" />
                <FlareColumn TItem="TrackerConnectionDto" Title="@UiStrings.Common_Type">
                    <Template>
                        <FlareChip Label="@context.TrackerType" Size="ChipSize.Sm" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="TrackerConnectionDto" Title="@UiStrings.Common_ApiUrl" Field="@(c => c.ApiUrl)" />
                <FlareColumn TItem="TrackerConnectionDto" Title="@UiStrings.Provider_Col_Settings">
                    <Template>
                        @* Whatever the provider declared, rather than one provider's field. Secrets are
                           never in this data, so nothing here can leak one. *@
                        @if (context.Settings is not { Count: > 0 })
                        {
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Secondary">—</FlareText>
                        }
                        else
                        {
                            <FlareStack Row Gap="FlareSpacing.XSmall" Wrap>
                                @foreach (var (key, value) in context.Settings.OrderBy(s => s.Key, StringComparer.Ordinal))
                                {
                                    <FlareChip Size="ChipSize.Sm" Label="@($"{key}: {value}")" />
                                }
                            </FlareStack>
                        }
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="TrackerConnectionDto" Title="" Align="ColumnAlign.End">
                    <Template>
                        <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                            <FlareIconButton AriaLabel="@string.Format(UiStrings.Common_Edit_Aria, context.Name)" OnClick="@(() => OpenEdit(context))">
                                <FlareIconView Value="MaterialDesign3Icons.Regular.Edit" />
                            </FlareIconButton>
                            <FlareIconButton AriaLabel="@string.Format(UiStrings.Common_Delete_Aria, context.Name)" Color="FlareColor.Error" OnClick="@(() => Delete(context))">
                                <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                            </FlareIconButton>
                        </FlareStack>
                    </Template>
                </FlareColumn>
            </Columns>
        </FlareDataGrid>

        @if (Result.Total > Result.PageSize)
        {
            <FlarePagination Current="Page" CurrentChanged="LoadPage" TotalPages="TotalPages"
                             TotalItems="Result.Total" PageSize="Result.PageSize" ShowInfo />
        }
    }
</FlareStack>

<FlareDialog Visible="ShowModal"
             Title="@(_editId.HasValue ? UiStrings.Tracker_Dialog_Edit : UiStrings.Tracker_Dialog_New)"
             VisibleChanged="OnDialogVisibleChanged">
    <ChildContent>
        @* A form so Enter saves. The dialog renders its actions separately, so the Save button is not
           inside this element and cannot be the submit control — hence the hidden one at the end. *@
        <form @onsubmit="Save" @onsubmit:preventDefault>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareTextField Label="@UiStrings.Common_Name" @bind-Value="_fName" />
            @if (!_editId.HasValue)
            {
                <FlareSelect TValue="string" Label="@UiStrings.Common_Type"
                             Value="_fType" ValueChanged="OnTypeChanged" Items="TrackerTypes" />
            }
            <FlareTextField Label="@UiStrings.Common_ApiUrl" @bind-Value="_fUrl" Placeholder="https://api.tracker.yandex.net" />

            @* Declared by the selected provider, not by this page. *@
            <ProviderSettingsFields Schema="SelectedSchema" Values="_fSettings" OnChanged="StateHasChanged" />

            <FlarePasswordField Label="@(_editId.HasValue ? UiStrings.Common_AccessToken_Keep : UiStrings.Common_AccessToken)"
                                @bind-Value="_fToken" />
        </FlareStack>
        <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
        </form>
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseModal">@UiStrings.Common_Cancel</FlareButton>
        <FlareButton OnClick="Save" Loading="Saving" Disabled="IsFormIncomplete">@UiStrings.Common_Save</FlareButton>
    </Actions>
</FlareDialog>

@code {
    // Served by the API, not compiled in: this page used to hold a literal ["YandexTracker"]
    // alongside that provider's own orgId field, so a second tracker meant editing the page.
    List<ProviderTypeDto>? _providers;

    Guid? _editId;
    string _fName = "", _fType = "", _fUrl = "", _fToken = "";
    Dictionary<string, string> _fSettings = [];

    IEnumerable<string> TrackerTypes => _providers?.Select(p => p.ProviderType) ?? [];

    IReadOnlyList<ProviderSettingDto> SelectedSchema =>
        _providers?.FirstOrDefault(p => p.ProviderType == _fType)?.Settings ?? [];

    // As with VCS connections, the type is fixed at creation and Update does not accept it.
    /// <summary>Enter submits the dialog too, so the keyboard refuses what the disabled button does.</summary>
    protected override bool IsEditorIncomplete => IsFormIncomplete;

    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fUrl)
                             || string.IsNullOrWhiteSpace(_fType)
                             || (!_editId.HasValue && string.IsNullOrWhiteSpace(_fToken))
                             || ProviderSettingsFields.MissingRequired(SelectedSchema, _fSettings, _editId.HasValue);

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () => _providers = await Api.GetTrackerProviderTypesAsync());
        await base.OnInitializedAsync();
    }

    protected override Task<PagedResult<TrackerConnectionDto>> FetchPageAsync(int page) =>
        Api.GetTrackerConnectionsAsync(page);

    void OpenCreate()
    {
        _editId = null;
        _fName = ""; _fUrl = ""; _fToken = "";
        // The first registered provider, so a single-provider install needs no choice made; with
        // several, the operator picks and the fields follow.
        _fType = TrackerTypes.FirstOrDefault() ?? "";
        _fSettings = ProviderSettingsFields.Blank(SelectedSchema);
        ShowModal = true;
    }

    void OpenEdit(TrackerConnectionDto c)
    {
        _editId = c.Id;
        _fName = c.Name; _fType = c.TrackerType; _fUrl = c.ApiUrl;
        _fToken = "";
        _fSettings = ProviderSettingsFields.ForEdit(SelectedSchema, c.Settings);
        ShowModal = true;
    }

    /// <summary>Switching provider starts a fresh value map: the keys belong to the old schema.</summary>
    void OnTypeChanged(string value)
    {
        _fType = value;
        _fSettings = ProviderSettingsFields.Blank(SelectedSchema);
    }

    Task Save() => SaveAsync(async () =>
    {
        var settings = ProviderSettingsFields.ForSubmit(_fSettings);

        if (_editId.HasValue)
            await Api.UpdateTrackerConnectionAsync(_editId.Value, _fName, _fUrl, _fToken, settings);
        else
            await Api.CreateTrackerConnectionAsync(_fName, _fType, _fUrl, _fToken, settings);
    });

    Task Delete(TrackerConnectionDto c) =>
        DeleteAsync(string.Format(UiStrings.Tracker_Delete_What, c.Name), () => Api.DeleteTrackerConnectionAsync(c.Id));
}
