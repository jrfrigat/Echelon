@page "/admin/trackers"
@attribute [Authorize]
@inherits CrudPageBase<TrackerConnectionDto>

<PageTitle>Tracker Connections</PageTitle>

<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">Tracker Connections</FlareText>
    <FlareSpacer />
    <FlareButton Size="ButtonSize.Sm" OnClick="OpenCreate">
        <LeadingIcon><FlareIcon Name="@FlareIcons.Add" /></LeadingIcon>
        <ChildContent>New Connection</ChildContent>
    </FlareButton>
</FlareStack>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (Loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (Result is not null)
{
    <FlareDataGrid TItem="TrackerConnectionDto" Items="Result.Items" ShowPager="false">
        <Columns>
            <FlareColumn TItem="TrackerConnectionDto" Title="Name" Field="@(c => c.Name)" />
            <FlareColumn TItem="TrackerConnectionDto" Title="Type">
                <Template>
                    <FlareChip Label="@context.TrackerType" Size="ChipSize.Sm" />
                </Template>
            </FlareColumn>
            <FlareColumn TItem="TrackerConnectionDto" Title="API URL" Field="@(c => c.ApiUrl)" />
            <FlareColumn TItem="TrackerConnectionDto" Title="Org ID" Field="@(c => c.OrgId)" />
            <FlareColumn TItem="TrackerConnectionDto" Title="" Align="ColumnAlign.End">
                <Template>
                    <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                        <FlareIconButton AriaLabel="@($"Edit {context.Name}")" OnClick="@(() => OpenEdit(context))">
                            <FlareIcon Name="@FlareIcons.Edit" />
                        </FlareIconButton>
                        <FlareIconButton AriaLabel="@($"Delete {context.Name}")" Color="FlareColor.Error" OnClick="@(() => Delete(context))">
                            <FlareIcon Name="@FlareIcons.Delete" />
                        </FlareIconButton>
                    </FlareStack>
                </Template>
            </FlareColumn>
        </Columns>
    </FlareDataGrid>

    @if (Result.Total > Result.PageSize)
    {
        <FlarePagination Current="Page" CurrentChanged="LoadPage" TotalPages="TotalPages"
                         TotalItems="Result.Total" PageSize="Result.PageSize" ShowInfo />
    }
}

<FlareDialog Visible="ShowModal"
             Title="@(_editId.HasValue ? "Edit Tracker Connection" : "New Tracker Connection")"
             VisibleChanged="OnDialogVisibleChanged">
    <ChildContent>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareTextField Label="Name" @bind-Value="_fName" />
            @if (!_editId.HasValue)
            {
                <FlareSelect TValue="string" Label="Type" @bind-Value="_fType" Items="TrackerTypes" />
            }
            <FlareTextField Label="API URL" @bind-Value="_fUrl" Placeholder="https://api.tracker.yandex.net" />
            <FlareTextField Label="Org ID (optional)" @bind-Value="_fOrgId" Placeholder="Yandex organization ID" />
            <FlarePasswordField Label="@($"Access Token{(_editId.HasValue ? " (leave blank to keep current)" : "")}")"
                                @bind-Value="_fToken" />
        </FlareStack>
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseModal">Cancel</FlareButton>
        <FlareButton OnClick="Save" Loading="Saving" Disabled="IsFormIncomplete">Save</FlareButton>
    </Actions>
</FlareDialog>

@code {
    static readonly string[] TrackerTypes = ["YandexTracker"];

    Guid? _editId;
    string _fName = "", _fType = "YandexTracker", _fUrl = "", _fOrgId = "", _fToken = "";

    // As with VCS connections, the type is fixed at creation and Update does not accept it.
    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fUrl)
                             || (!_editId.HasValue && string.IsNullOrWhiteSpace(_fToken));

    protected override Task<PagedResult<TrackerConnectionDto>> FetchPageAsync(int page) =>
        Api.GetTrackerConnectionsAsync(page);

    void OpenCreate()
    {
        _editId = null;
        _fName = ""; _fType = "YandexTracker"; _fUrl = ""; _fOrgId = ""; _fToken = "";
        ShowModal = true;
    }

    void OpenEdit(TrackerConnectionDto c)
    {
        _editId = c.Id;
        _fName = c.Name; _fType = c.TrackerType; _fUrl = c.ApiUrl; _fOrgId = c.OrgId ?? "";
        _fToken = "";
        ShowModal = true;
    }

    Task Save() => SaveAsync(async () =>
    {
        var orgId = string.IsNullOrWhiteSpace(_fOrgId) ? null : _fOrgId.Trim();

        if (_editId.HasValue)
            await Api.UpdateTrackerConnectionAsync(_editId.Value, _fName, _fUrl, orgId, _fToken);
        else
            await Api.CreateTrackerConnectionAsync(_fName, _fType, _fUrl, orgId, _fToken);
    });

    Task Delete(TrackerConnectionDto c) =>
        DeleteAsync($"tracker connection '{c.Name}'", () => Api.DeleteTrackerConnectionAsync(c.Id));
}
