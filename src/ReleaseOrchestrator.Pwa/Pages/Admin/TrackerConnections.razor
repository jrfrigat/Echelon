@page "/admin/trackers"
@attribute [Authorize]
@inherits CrudPageBase<TrackerConnectionDto>

<PageTitle>Tracker Connections</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Tracker Connections</h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Connection</button>
</div>

<Alert Message="@Error" Type="danger" OnDismiss="@(() => Error = null)" />
<Alert Message="@Success" Type="success" OnDismiss="@(() => Success = null)" />

@if (Loading) { <Spinner /> }
else if (Result is not null)
{
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>Type</th><th>API URL</th><th>Org ID</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Result.Items)
        {
            <tr>
                <td>@c.Name</td>
                <td><span class="badge bg-secondary">@c.TrackerType</span></td>
                <td class="text-muted small">@c.ApiUrl</td>
                <td class="text-muted small">@c.OrgId</td>
                <td class="text-end">
                    <button class="btn btn-outline-secondary btn-sm me-1" @onclick="@(() => OpenEdit(c))">Edit</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="@(() => Delete(c))">Delete</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <Pager Result="Result" Page="Page" OnPageChange="LoadPage" />
}

<ModalDialog Visible="ShowModal"
             Title="@(_editId.HasValue ? "Edit Tracker Connection" : "New Tracker Connection")"
             OnClose="CloseModal"
             OnSave="Save"
             Saving="Saving"
             SaveDisabled="@IsFormIncomplete">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" @bind="_fName" />
    </div>
    @if (!_editId.HasValue)
    {
        <div class="mb-3">
            <label class="form-label">Type</label>
            <select class="form-select" @bind="_fType">
                <option value="YandexTracker">YandexTracker</option>
            </select>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">API URL</label>
        <input class="form-control" @bind="_fUrl" placeholder="https://api.tracker.yandex.net" />
    </div>
    <div class="mb-3">
        <label class="form-label">Org ID (optional)</label>
        <input class="form-control" @bind="_fOrgId" placeholder="Yandex organization ID" />
    </div>
    <div class="mb-3">
        <label class="form-label">Access Token @(_editId.HasValue ? "(leave blank to keep current)" : "")</label>
        <input class="form-control" type="password" @bind="_fToken" />
    </div>
</ModalDialog>

@code {
    Guid? _editId;
    string _fName = "", _fType = "YandexTracker", _fUrl = "", _fOrgId = "", _fToken = "";

    // As with VCS connections, the type is fixed at creation and Update does not accept it.
    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fUrl)
                             || (!_editId.HasValue && string.IsNullOrWhiteSpace(_fToken));

    protected override Task<PagedResult<TrackerConnectionDto>> FetchPageAsync(int page) =>
        Api.GetTrackerConnectionsAsync(page);

    void OpenCreate()
    {
        _editId = null;
        _fName = ""; _fType = "YandexTracker"; _fUrl = ""; _fOrgId = ""; _fToken = "";
        ShowModal = true;
    }

    void OpenEdit(TrackerConnectionDto c)
    {
        _editId = c.Id;
        _fName = c.Name; _fType = c.TrackerType; _fUrl = c.ApiUrl; _fOrgId = c.OrgId ?? "";
        _fToken = "";
        ShowModal = true;
    }

    void CloseModal() => ShowModal = false;

    Task Save() => SaveAsync(async () =>
    {
        var orgId = string.IsNullOrWhiteSpace(_fOrgId) ? null : _fOrgId.Trim();

        if (_editId.HasValue)
            await Api.UpdateTrackerConnectionAsync(_editId.Value, _fName, _fUrl, orgId, _fToken);
        else
            await Api.CreateTrackerConnectionAsync(_fName, _fType, _fUrl, orgId, _fToken);
    });

    Task Delete(TrackerConnectionDto c) =>
        DeleteAsync($"tracker connection '{c.Name}'", () => Api.DeleteTrackerConnectionAsync(c.Id));
}
