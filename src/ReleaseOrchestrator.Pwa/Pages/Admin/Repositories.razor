@page "/admin/repos"
@attribute [Authorize]
@inherits CrudPageBase<RepositoryDto>

<PageTitle>Repositories</PageTitle>

<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">Repositories</FlareText>
    <FlareSpacer />
    <FlareButton Size="ButtonSize.Sm" OnClick="OpenCreate">
        <LeadingIcon><FlareIcon Name="@FlareIcons.Add" /></LeadingIcon>
        <ChildContent>New Repository</ChildContent>
    </FlareButton>
</FlareStack>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (Loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (Result is not null)
{
    <FlareDataGrid TItem="RepositoryDto" Items="Result.Items" ShowPager="false">
        <Columns>
            <FlareColumn TItem="RepositoryDto" Title="Name" Field="@(r => r.Name)" />
            <FlareColumn TItem="RepositoryDto" Title="External ID" Field="@(r => r.ExternalId)" />
            <FlareColumn TItem="RepositoryDto" Title="VCS Connection" Field="@(r => r.ConnectionName)" />
            <FlareColumn TItem="RepositoryDto" Title="" Align="ColumnAlign.End">
                <Template>
                    <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                        <FlareIconButton AriaLabel="@($"Delete {context.Name}")" Color="FlareColor.Error" OnClick="@(() => Delete(context))">
                            <FlareIcon Name="@FlareIcons.Delete" />
                        </FlareIconButton>
                    </FlareStack>
                </Template>
            </FlareColumn>
        </Columns>
    </FlareDataGrid>

    @if (Result.Total > Result.PageSize)
    {
        <FlarePagination Current="Page" CurrentChanged="LoadPage" TotalPages="TotalPages"
                         TotalItems="Result.Total" PageSize="Result.PageSize" ShowInfo />
    }
}

<FlareDialog Visible="ShowModal" Title="New Repository" VisibleChanged="OnDialogVisibleChanged">
    <ChildContent>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareTextField Label="Name" @bind-Value="_fName" />
            <FlareTextField Label="External ID" @bind-Value="_fExternalId" Placeholder="GitLab project ID or path" />
            @if (_connections is null)
            {
                <FlareProgress Variant="ProgressVariant.Circular" />
            }
            else
            {
                <FlareSelect TValue="Guid" Label="VCS Connection" @bind-Value="_fConnectionId"
                             Items="@_connections.Items.Select(c => c.Id)"
                             ItemLabel="@(id => ConnectionLabel(id))" />
            }
        </FlareStack>
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseModal">Cancel</FlareButton>
        <FlareButton OnClick="Save" Loading="Saving" Disabled="IsFormIncomplete">Save</FlareButton>
    </Actions>
</FlareDialog>

@code {
    PagedResult<VcsConnectionDto>? _connections;

    string _fName = "", _fExternalId = "";
    Guid _fConnectionId;

    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fExternalId)
                             || _fConnectionId == Guid.Empty;

    protected override Task<PagedResult<RepositoryDto>> FetchPageAsync(int page) =>
        Api.GetRepositoriesAsync(page);

    string ConnectionLabel(Guid id)
    {
        var c = _connections?.Items.FirstOrDefault(x => x.Id == id);
        return c is null ? id.ToString() : $"{c.Name} ({c.VcsType})";
    }

    async Task OpenCreate()
    {
        _fName = ""; _fExternalId = ""; _fConnectionId = Guid.Empty;
        ShowModal = true;

        if (_connections is not null) return;

        await RunAsync(async () => _connections = await Api.GetVcsConnectionsAsync());
    }

    Task Save() => SaveAsync(
        () => Api.CreateRepositoryAsync(_fName, _fExternalId, _fConnectionId),
        "Repository created.");

    Task Delete(RepositoryDto r) =>
        DeleteAsync($"repository '{r.Name}'", () => Api.DeleteRepositoryAsync(r.Id));
}
