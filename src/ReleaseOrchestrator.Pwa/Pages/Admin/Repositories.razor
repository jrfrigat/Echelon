@page "/admin/repos"
@attribute [Authorize]
@inherits CrudPageBase<RepositoryDto>

<PageTitle>Repositories</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Repositories</h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Repository</button>
</div>

<Alert Message="@Error" Type="danger" OnDismiss="@(() => Error = null)" />
<Alert Message="@Success" Type="success" OnDismiss="@(() => Success = null)" />

@if (Loading) { <Spinner /> }
else if (Result is not null)
{
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>External ID</th><th>VCS Connection</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Result.Items)
        {
            <tr>
                <td>@r.Name</td>
                <td class="text-muted small">@r.ExternalId</td>
                <td class="small">@r.ConnectionName</td>
                <td class="text-end">
                    <button class="btn btn-outline-danger btn-sm" @onclick="@(() => Delete(r))">Delete</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <Pager Result="Result" Page="Page" OnPageChange="LoadPage" />
}

<ModalDialog Visible="ShowModal"
             Title="New Repository"
             OnClose="CloseModal"
             OnSave="Save"
             Saving="Saving"
             SaveDisabled="@IsFormIncomplete">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" @bind="_fName" />
    </div>
    <div class="mb-3">
        <label class="form-label">External ID</label>
        <input class="form-control" @bind="_fExternalId" placeholder="GitLab project ID or path" />
    </div>
    <div class="mb-3">
        <label class="form-label">VCS Connection</label>
        @if (_connections is null)
        {
            <Spinner />
        }
        else
        {
            <select class="form-select" @bind="_fConnectionId">
                <option value="">-- Select connection --</option>
                @foreach (var c in _connections.Items)
                {
                    <option value="@c.Id">@c.Name (@c.VcsType)</option>
                }
            </select>
        }
    </div>
</ModalDialog>

@code {
    PagedResult<VcsConnectionDto>? _connections;

    string _fName = "", _fExternalId = "";
    Guid _fConnectionId;

    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fExternalId)
                             || _fConnectionId == Guid.Empty;

    protected override Task<PagedResult<RepositoryDto>> FetchPageAsync(int page) =>
        Api.GetRepositoriesAsync(page);

    async Task OpenCreate()
    {
        _fName = ""; _fExternalId = ""; _fConnectionId = Guid.Empty;
        ShowModal = true;

        if (_connections is not null) return;

        await RunAsync(async () => _connections = await Api.GetVcsConnectionsAsync());
    }

    void CloseModal() => ShowModal = false;

    Task Save() => SaveAsync(
        () => Api.CreateRepositoryAsync(_fName, _fExternalId, _fConnectionId),
        "Repository created.");

    Task Delete(RepositoryDto r) =>
        DeleteAsync($"repository '{r.Name}'", () => Api.DeleteRepositoryAsync(r.Id));
}
