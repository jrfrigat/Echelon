@page "/admin/action-handlers"
@attribute [Authorize]
@inherits PageBase

<PageTitle>@UiStrings.Actions_Title</PageTitle>

<FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">@UiStrings.Actions_Heading</FlareText>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

<FlareCard>
    <FlareCardContent>
        <FlareStack Gap="FlareSpacing.Small">
            <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End">
                <FlareTextField Label="@UiStrings.Actions_Event" @bind-Value="_eventType" HelperText="@UiStrings.Actions_EventHint" />
                <div>
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@UiStrings.Actions_Action</FlareText>
                    <select value="@_actionType" @onchange="OnActionTypeChanged">
                        <option value="">--</option>
                        @if (_types is not null)
                        {
                            @foreach (var type in _types)
                            {
                                <option value="@type.ActionType">@type.ActionType</option>
                            }
                        }
                    </select>
                </div>
                <FlareTextField Label="@UiStrings.Actions_Scope" @bind-Value="_scope" />
            </FlareStack>

            @if (SelectedType is { Settings.Count: > 0 } selected)
            {
                <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End">
                    @foreach (var setting in selected.Settings)
                    {
                        <FlareTextField Label="@setting.Label"
                                        Value="@_settings.GetValueOrDefault(setting.Key, "")"
                                        ValueChanged="@(v => _settings[setting.Key] = v)" />
                    }
                </FlareStack>
            }

            <div>
                <FlareButton OnClick="Create" Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_actionType) || string.IsNullOrWhiteSpace(_eventType))">
                    @UiStrings.Actions_Add
                </FlareButton>
            </div>
        </FlareStack>
    </FlareCardContent>
</FlareCard>

@if (_loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (_bindings is null || _bindings.Count == 0)
{
    <FlareEmptyState Title="@UiStrings.Actions_Empty_Title" Description="@UiStrings.Actions_Empty_Description" />
}
else
{
    <FlareTable TItem="ActionBindingDto" Items="_bindings">
        <HeaderContent>
            <tr>
                <th>@UiStrings.Actions_Col_Event</th>
                <th>@UiStrings.Actions_Col_Action</th>
                <th>@UiStrings.Actions_Col_Scope</th>
                <th>@UiStrings.Actions_Col_Enabled</th>
                <th></th>
            </tr>
        </HeaderContent>
        <RowTemplate Context="b">
            <td>@b.EventType</td>
            <td>@b.ActionType</td>
            <td>@(string.IsNullOrEmpty(b.Scope) ? "-" : b.Scope)</td>
            <td>
                <FlareChip Size="ChipSize.Sm" Color="@(b.Enabled ? FlareColor.Success : FlareColor.OnSurfaceVariant)">
                    @(b.Enabled ? "+" : "-")
                </FlareChip>
            </td>
            <td>
                <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error" OnClick="@(() => Delete(b))">
                    <FlareIcon Name="@FlareIcons.Close" />
                </FlareIconButton>
            </td>
        </RowTemplate>
    </FlareTable>
}

@code {
    List<ActionBindingDto>? _bindings;
    List<ActionTypeDto>? _types;
    bool _loading = true;
    bool _busy;

    string _eventType = "";
    string _actionType = "";
    string _scope = "";
    Dictionary<string, string> _settings = [];

    ActionTypeDto? SelectedType => _types?.FirstOrDefault(t => t.ActionType == _actionType);

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () =>
        {
            _types = await Api.GetActionTypesAsync();
            _bindings = await Api.GetActionBindingsAsync();
        });
        _loading = false;
    }

    void OnActionTypeChanged(ChangeEventArgs e)
    {
        _actionType = e.Value?.ToString() ?? "";
        // Start a fresh settings map keyed by the chosen type's schema.
        _settings = SelectedType?.Settings.ToDictionary(s => s.Key, _ => "") ?? [];
    }

    async Task Create()
    {
        _busy = true;
        var settings = _settings
            .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

        if (await RunAsync(
                async () => await Api.CreateActionBindingAsync(
                    _eventType.Trim(), _actionType, string.IsNullOrWhiteSpace(_scope) ? null : _scope.Trim(), settings, 0, true),
                UiStrings.Actions_Created))
        {
            _eventType = ""; _scope = ""; _actionType = ""; _settings = [];
            await Reload();
        }
        _busy = false;
    }

    async Task Delete(ActionBindingDto binding)
    {
        if (!await ConfirmAsync(UiStrings.Actions_Delete_Title, UiStrings.Actions_Delete_Message)) return;
        if (await RunAsync(async () => await Api.DeleteActionBindingAsync(binding.Id), UiStrings.Actions_Deleted))
            await Reload();
    }

    async Task Reload() => await RunAsync(async () => _bindings = await Api.GetActionBindingsAsync());
}
