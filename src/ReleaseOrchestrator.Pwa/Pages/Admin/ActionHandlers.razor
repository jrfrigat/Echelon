@page "/admin/action-handlers"
@attribute [Authorize]
@inherits PageBase

<PageTitle>@UiStrings.Actions_Title</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.Actions_Heading" />

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            @* A real form so Enter adds the binding; every add-form in the app was a bare stack of
               inputs, so Enter did nothing and the button had to be found with the mouse. *@
            <form @onsubmit="Create" @onsubmit:preventDefault>
            <FlareStack Gap="FlareSpacing.Small">
                @* Align Start: the labels sit above the inputs, so aligning tops lines the inputs up.
                   Aligning the bottoms lined up the helper text instead, which only one field had, and
                   lifted that field a row above its neighbours. The hint now sits under the row. *@
                <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Start" Wrap>
                    <FlareTextField Label="@UiStrings.Actions_Event" @bind-Value="_eventType" Style="min-width:16rem;" />
                    <FlareSelect TValue="string" Label="@UiStrings.Actions_Action"
                                 Value="_actionType" ValueChanged="OnActionTypeChanged"
                                 Items="ActionTypeOptions" ItemLabel="@(t => string.IsNullOrEmpty(t) ? "-" : t)"
                                 Style="min-width:14rem;" />
                    <FlareTextField Label="@UiStrings.Actions_Scope" @bind-Value="_scope" Style="min-width:12rem;" />
                </FlareStack>
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                    @UiStrings.Actions_EventHint
                </FlareText>

                @if (SelectedType is { Settings.Count: > 0 } selected)
                {
                    <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Start" Wrap>
                        @* The same renderer the connection forms use — one place that turns a declared
                           schema into inputs, so the secret-handling rules cannot diverge between them. *@
                        <ProviderSettingsFields Schema="selected.Settings" Values="_settings" OnChanged="StateHasChanged" />
                    </FlareStack>
                }

                <FlareStack Row>
                    <FlareButton Type="ButtonType.Submit" Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_actionType) || string.IsNullOrWhiteSpace(_eventType) || MissingRequired)">
                        @UiStrings.Actions_Add
                    </FlareButton>
                </FlareStack>
            </FlareStack>
            </form>
        </FlareCardContent>
    </FlareCard>

    @if (_loading)
    {
        <FlareProgress Variant="ProgressVariant.Circular" />
    }
    else if (_bindings is null || _bindings.Count == 0)
    {
        <FlareEmptyState Title="@UiStrings.Actions_Empty_Title" Description="@UiStrings.Actions_Empty_Description" />
    }
    else
    {
        <FlareDataGrid TItem="ActionBindingDto" Items="_bindings" Dense="true" Striped="true" Hoverable="true" ShowPager="false">
            <Columns>
                <FlareColumn TItem="ActionBindingDto" Id="event" Title="@UiStrings.Actions_Col_Event"
                             Field="@(b => (object?)b.EventType)" Sortable="true" Filterable="true" />
                <FlareColumn TItem="ActionBindingDto" Id="action" Title="@UiStrings.Actions_Col_Action"
                             Field="@(b => (object?)b.ActionType)" Sortable="true" Filterable="true" />
                <FlareColumn TItem="ActionBindingDto" Id="scope" Title="@UiStrings.Actions_Col_Scope"
                             Field="@(b => (object?)(string.IsNullOrEmpty(b.Scope) ? "-" : b.Scope))" Sortable="true" />
                <FlareColumn TItem="ActionBindingDto" Id="enabled" Title="@UiStrings.Actions_Col_Enabled">
                    <Template>
                        <FlareChip Size="ChipSize.Sm" Color="@(context.Enabled ? FlareColor.Success : FlareColor.OnSurfaceVariant)" Label="@(context.Enabled ? UiStrings.Common_Yes : UiStrings.Common_No)" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="ActionBindingDto" Id="actions" Title="" Align="ColumnAlign.End">
                    <Template>
                        <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                         AriaLabel="@string.Format(UiStrings.Common_Delete_Aria, context.ActionType)"
                                         OnClick="@(() => Delete(context))">
                            <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                        </FlareIconButton>
                    </Template>
                </FlareColumn>
            </Columns>
        </FlareDataGrid>
    }
</FlareStack>

@code {
    List<ActionBindingDto>? _bindings;
    List<ActionTypeDto>? _types;
    bool _loading = true;
    bool _busy;

    string _eventType = "";
    string _actionType = "";
    string _scope = "";
    Dictionary<string, string> _settings = [];

    ActionTypeDto? SelectedType => _types?.FirstOrDefault(t => t.ActionType == _actionType);

    // A setting the schema marks Required must be filled. The server enforces this too, so this is
    // only about learning it before a round trip. Always "creating" here: this form has no edit mode,
    // so a blank secret is genuinely missing rather than "keep the stored one".
    bool MissingRequired =>
        ProviderSettingsFields.MissingRequired(SelectedType?.Settings ?? [], _settings, editing: false);

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () =>
        {
            _types = await Api.GetActionTypesAsync();
            _bindings = await Api.GetActionBindingsAsync();
        });
        _loading = false;
    }

    /// <summary>The empty entry is the unselected state; the rest come from the server's schema.</summary>
    IEnumerable<string> ActionTypeOptions =>
        ["", .. _types?.Select(t => t.ActionType) ?? []];

    void OnActionTypeChanged(string value)
    {
        _actionType = value;
        // Start a fresh settings map keyed by the chosen type's schema.
        _settings = SelectedType?.Settings.ToDictionary(s => s.Key, _ => "") ?? [];
    }

    async Task Create()
    {
        // Enter submits too, and a keypress does not consult the button's disabled state — so the
        // same conditions that disable it have to be re-checked here.
        if (_busy || string.IsNullOrWhiteSpace(_actionType) || string.IsNullOrWhiteSpace(_eventType) || MissingRequired)
            return;

        _busy = true;
        var settings = _settings
            .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

        if (await RunAsync(
                async () => await Api.CreateActionBindingAsync(
                    _eventType.Trim(), _actionType, string.IsNullOrWhiteSpace(_scope) ? null : _scope.Trim(), settings, 0, true),
                UiStrings.Actions_Created))
        {
            _eventType = ""; _scope = ""; _actionType = ""; _settings = [];
            await Reload();
        }
        _busy = false;
    }

    async Task Delete(ActionBindingDto binding)
    {
        if (!await ConfirmAsync(UiStrings.Actions_Delete_Title, UiStrings.Actions_Delete_Message)) return;
        if (await RunAsync(async () => await Api.DeleteActionBindingAsync(binding.Id), UiStrings.Actions_Deleted))
            await Reload();
    }

    async Task Reload() => await RunAsync(async () => _bindings = await Api.GetActionBindingsAsync());
}
