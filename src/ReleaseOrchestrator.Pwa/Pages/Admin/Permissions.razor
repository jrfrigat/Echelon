@page "/admin/permissions"
@attribute [Authorize]
@inherits PageBase

<PageTitle>@UiStrings.Perms_Title</PageTitle>

<FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">@UiStrings.Perms_Title</FlareText>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@if (_loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else
{
    <FlareGrid>
        <FlareCol Xs="12" Md="5">
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@UiStrings.Perms_Claims_Title" />
                <FlareCardContent>
                    @if (_claims is null || _claims.Count == 0)
                    {
                        <FlareEmptyState Title="@UiStrings.Perms_Claims_Empty" Compact />
                    }
                    else
                    {
                        <FlareList TItem="PermissionClaimDto" Dense>
                            @foreach (var claim in _claims)
                            {
                                <FlareListItem Primary="@claim.Name" />
                            }
                        </FlareList>
                    }
                </FlareCardContent>
            </FlareCard>
        </FlareCol>

        <FlareCol Xs="12" Md="7">
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@UiStrings.Perms_Mappings_Title">
                    <Action>
                        <FlareButton Size="ButtonSize.Sm" OnClick="@(() => _showAddMapping = !_showAddMapping)">
                            <LeadingIcon><FlareIconView Value="FlareIcons.Add" /></LeadingIcon>
                            <ChildContent>@UiStrings.Perms_AddMapping</ChildContent>
                        </FlareButton>
                    </Action>
                </FlareCardHeader>
                <FlareCardContent>
                    @if (_showAddMapping)
                    {
                        <FlareStack Gap="FlareSpacing.Small">
                            <FlareTextField Label="@UiStrings.Perms_Sid" @bind-Value="_fSid" Placeholder="S-1-5-..." Size="FieldSize.Sm" />
                            <FlareSelect TValue="Guid?" Label="@UiStrings.Perms_Claim" @bind-Value="_fClaimId" Size="FieldSize.Sm"
                                         Items="@(_claims?.Select(c => (Guid?)c.Id) ?? [])"
                                         ItemLabel="@(id => ClaimName(id))" />
                            <FlareStack Row Gap="FlareSpacing.Small">
                                <FlareButton Size="ButtonSize.Sm" OnClick="AddMapping" Loading="_savingMapping"
                                             Disabled="@(string.IsNullOrWhiteSpace(_fSid) || _fClaimId is null)">@UiStrings.Common_Add</FlareButton>
                                <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text"
                                             OnClick="@(() => _showAddMapping = false)">@UiStrings.Common_Cancel</FlareButton>
                            </FlareStack>
                            <FlareDivider />
                        </FlareStack>
                    }

                    @if (_mappings is null || _mappings.Count == 0)
                    {
                        <FlareEmptyState Title="@UiStrings.Perms_Mappings_Empty" Compact />
                    }
                    else
                    {
                        <FlareDataGrid TItem="GroupMappingDto" Items="_mappings" ShowPager="false">
                            <Columns>
                                <FlareColumn TItem="GroupMappingDto" Title="@UiStrings.Perms_Sid">
                                    <Template>
                                        <FlareText Typo="TypographyScale.BodySmall" Mono>@context.AdGroupSid</FlareText>
                                    </Template>
                                </FlareColumn>
                                <FlareColumn TItem="GroupMappingDto" Title="@UiStrings.Perms_Col_Claim" Field="@(m => m.ClaimName)" />
                                <FlareColumn TItem="GroupMappingDto" Title="" Align="ColumnAlign.End">
                                    <Template>
                                        <FlareIconButton AriaLabel="@string.Format(UiStrings.Perms_Remove_Aria, context.ClaimName)" Color="FlareColor.Error"
                                                         OnClick="@(() => RemoveMapping(context))">
                                            <FlareIconView Value="FlareIcons.Close" />
                                        </FlareIconButton>
                                    </Template>
                                </FlareColumn>
                            </Columns>
                        </FlareDataGrid>
                    }
                </FlareCardContent>
            </FlareCard>
        </FlareCol>
    </FlareGrid>
}

@code {
    List<PermissionClaimDto>? _claims;
    List<GroupMappingDto>? _mappings;
    bool _loading = true;
    bool _showAddMapping, _savingMapping;

    string _fSid = "";
    Guid? _fClaimId;

    string ClaimName(Guid? id) => _claims?.FirstOrDefault(c => c.Id == id)?.Name ?? "";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await RunAsync(async () =>
        {
            var claimsTask = Api.GetPermissionClaimsAsync();
            var mappingsTask = Api.GetGroupMappingsAsync();
            await Task.WhenAll(claimsTask, mappingsTask);

            _claims = await claimsTask;
            _mappings = await mappingsTask;
        });
        _loading = false;
    }

    async Task AddMapping()
    {
        if (_fClaimId is not { } claimId) return;

        _savingMapping = true;
        var added = await RunAsync(() => Api.AddGroupMappingAsync(_fSid, claimId), UiStrings.Perms_MappingAdded);
        _savingMapping = false;

        if (!added) return;

        _showAddMapping = false;
        _fSid = ""; _fClaimId = null;
        await ReloadMappings();
    }

    async Task RemoveMapping(GroupMappingDto m)
    {
        if (!await ConfirmAsync(
                UiStrings.Perms_Remove_Title,
                string.Format(UiStrings.Perms_Remove_Message, m.ClaimName, m.AdGroupSid))) return;

        if (await RunAsync(() => Api.RemoveGroupMappingAsync(m.Id), UiStrings.Perms_MappingRemoved))
            await ReloadMappings();
    }

    Task ReloadMappings() => RunAsync(async () => _mappings = await Api.GetGroupMappingsAsync());
}
