@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageService Lang

<FlareLayout>
    <FlareLayoutAppBar DrawerToggle="true">
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Style="flex:1;min-width:0;">
            <FlareLink Href="/" Underline="LinkUnderline.None" Color="FlareColor.Default">
                <FlareText Typo="TypographyScale.TitleMedium" Weight="FontWeight.Bold">Release Orchestrator</FlareText>
            </FlareLink>
            <FlareSpacer />
            @* Outside AuthorizeView: the language is picked before signing in as readily as after. *@
            <LanguageSwitcher />
            <AuthorizeView>
                <Authorized>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Href="authentication/logout">
                        <LeadingIcon><FlareIcon Name="logout" /></LeadingIcon>
                        <ChildContent>@UiStrings.Shell_Logout</ChildContent>
                    </FlareButton>
                </Authorized>
            </AuthorizeView>
        </FlareStack>
    </FlareLayoutAppBar>

    @* The drawer is gated on auth rather than NavMenu hiding its own contents: an empty rail next to
       the sign-in redirect is still a rail. *@
    <AuthorizeView>
        <Authorized>
            <FlareLayoutDrawer @bind-Open="_navOpen" Variant="DrawerVariant.Responsive" Width="16rem">
                <NavMenu />
            </FlareLayoutDrawer>
        </Authorized>
    </AuthorizeView>

    <FlareLayoutContent>
        @Body
    </FlareLayoutContent>
</FlareLayout>

@code {
    bool _navOpen = true;

    // LayoutComponentBase cannot inherit LocalizedComponent, so the subscription is by hand.
    protected override void OnInitialized() => Lang.LanguageChanged += OnLanguageChanged;

    void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lang.LanguageChanged -= OnLanguageChanged;
}
