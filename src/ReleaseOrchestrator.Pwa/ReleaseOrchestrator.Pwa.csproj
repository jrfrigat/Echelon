<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RootNamespace>ReleaseOrchestrator.Pwa</RootNamespace>
    <!--
      Without this the runtime ships only the ICU shard matching the browser's locale, so a user
      on an English browser switching to Russian gets a CultureNotFoundException. The app also
      formats plan timestamps per culture, which needs the ru-RU date patterns.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" />
    <!-- Supplies AddHttpClient, which is what attaches the MSAL access-token handler. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Flare.Blazor is the meta-package (Flare.Components + Flare.Infrastructure). Themes ship
         separately and are referenced explicitly; VisualStudio is the only one this app registers. -->
    <PackageReference Include="Flare.Blazor" />
    <PackageReference Include="Flare.Theme.VisualStudio" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\UiStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>UiStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\UiStrings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>UiStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
