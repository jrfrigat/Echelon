<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RootNamespace>ReleaseOrchestrator.Pwa</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.10" />
    <!-- Supplies AddHttpClient, which is what attaches the MSAL access-token handler. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- Flare.Blazor is the meta-package (Flare.Components + Flare.Infrastructure). Themes ship
         separately and are referenced explicitly; VisualStudio is the only one this app registers. -->
    <PackageReference Include="Flare.Blazor" Version="0.5.0" />
    <PackageReference Include="Flare.Theme.VisualStudio" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
