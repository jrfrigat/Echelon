@typeparam TItem

@if (Result is not null && Result.Total > Result.PageSize)
{
    <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">Showing @Result.Items.Count of @Result.Total</small>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-1" disabled="@(Page <= 1)"
                    @onclick="@(() => OnPageChange.InvokeAsync(Page - 1))">Prev</button>
            <button class="btn btn-outline-secondary btn-sm" disabled="@(Page * Result.PageSize >= Result.Total)"
                    @onclick="@(() => OnPageChange.InvokeAsync(Page + 1))">Next</button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public PagedResult<TItem>? Result { get; set; }
    [Parameter, EditorRequired] public int Page { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnPageChange { get; set; }
}
