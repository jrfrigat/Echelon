@*
    Shared admin page header: a title and optional right-aligned actions, so every screen's heading
    row lines up identically instead of each page rolling its own <FlareStack Row> + <FlareText h1>.

    Composed only from Flare primitives. The title carries margin:0 because a bare <h1> brings a large
    default block margin that reads as excess padding at the top of every page; the surrounding page
    stack owns the vertical rhythm instead. Modelled on the reference apps' shared page header.
*@
<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall" Style="margin:0;">@Title</FlareText>
    @if (Actions is not null)
    {
        <FlareSpacer />
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">@Actions</FlareStack>
    }
</FlareStack>

@code {
    /// <summary>The page title, rendered as the page's single h1.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional right-aligned action controls (e.g. a "New" button) for the header row.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
