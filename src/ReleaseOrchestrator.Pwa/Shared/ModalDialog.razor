@if (Visible)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog @(Large ? "modal-lg" : null)">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button class="btn-close" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                @if (OnSave.HasDelegate || Footer is not null)
                {
                    <div class="modal-footer">
                        @if (Footer is not null)
                        {
                            @Footer
                        }
                        else
                        {
                            <button class="btn btn-secondary" @onclick="OnClose">Cancel</button>
                            <button class="btn btn-primary" @onclick="OnSave" disabled="@(Saving || SaveDisabled)">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @SaveText
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Large { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Replaces the default Cancel/confirm footer. Omit both this and OnSave for a footerless dialog.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public string SaveText { get; set; } = "Save";
}
