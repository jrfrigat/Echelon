<FlareThemeProvider>
    @* Cascades itself as the confirm-dialog host, so PageBase.ConfirmAsync can resolve it. *@
    <FlareConfirmDialogProvider>
        <CascadingAuthenticationState>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                        <NotAuthorized>
                            <RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Not found</PageTitle>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <FlareAlert Severity="AlertSeverity.Warning">Sorry, there's nothing at this address.</FlareAlert>
                    </LayoutView>
                </NotFound>
            </Router>
        </CascadingAuthenticationState>
    </FlareConfirmDialogProvider>
</FlareThemeProvider>
