<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contracts only: provider ports plus the normalized models they exchange. No implementation,
    no HTTP, no EF.

    This lives in its own assembly rather than inside Application on purpose (Backstage's
    plugin-*-node packages do the same). A provider adapter references this and nothing else of
    ours, so a breaking change to a port is a compile error in every adapter on the next
    `dotnet build` instead of a surprise at runtime.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Echelon.Core\Echelon.Core.csproj" />
  </ItemGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>Echelon.Providers.Abstractions</PackageId>
    <Description>Provider ports and the normalized models they exchange: VCS and tracker contracts, deploy strategies, action handlers, readiness signals. Reference this to write a Echelon provider.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
