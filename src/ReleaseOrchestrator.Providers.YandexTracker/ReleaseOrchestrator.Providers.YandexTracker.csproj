<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Yandex.Tracker adapter: HTTP client, closed-status dictionary, link normalization and the
    organization id that only this tracker has.

    References the provider contracts and Core, and nothing else of ours — see the GitLab adapter
    for why.
  -->

  <ItemGroup>
    <ProjectReference Include="..\ReleaseOrchestrator.Providers.Abstractions\ReleaseOrchestrator.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\ReleaseOrchestrator.Core\ReleaseOrchestrator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
