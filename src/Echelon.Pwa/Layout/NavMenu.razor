@inherits LocalizedComponent

@* Auth gating and the logout action live in MainLayout, which owns the drawer this sits in. *@
<FlareNavMenu AriaLabel="@UiStrings.Nav_Aria">
    @* Tasks is the home page. Exact only for "/", which would otherwise prefix-match every route
       and always look active. *@
    <FlareNavLink Href="/" Match="NavMatchMode.Exact">
        <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Checklist" /></Icon>
        <ChildContent>@UiStrings.Nav_Tasks</ChildContent>
    </FlareNavLink>
    <FlareNavLink Href="/rollouts">
        <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.RocketLaunch" /></Icon>
        <ChildContent>@UiStrings.Nav_Rollouts</ChildContent>
    </FlareNavLink>
    @* Beside the two it feeds: what ingestion produced, which is what a plan is built from. Without
       it a poll reporting "158 open merge requests" pointed at nothing an operator could open. *@
    <FlareNavLink Href="/merge-requests">
        <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.CallMerge" /></Icon>
        <ChildContent>@UiStrings.Nav_MergeRequests</ChildContent>
    </FlareNavLink>

    <FlareNavGroup Label="@UiStrings.Nav_Administration" Expanded="true">
        <FlareNavLink Href="/admin/vcs">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Link" /></Icon>
            <ChildContent>@UiStrings.Nav_VcsConnections</ChildContent>
        </FlareNavLink>
        <FlareNavLink Href="/admin/trackers">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Assignment" /></Icon>
            <ChildContent>@UiStrings.Nav_TrackerConnections</ChildContent>
        </FlareNavLink>
        <FlareNavLink Href="/admin/repos">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Folder" /></Icon>
            <ChildContent>@UiStrings.Nav_Repositories</ChildContent>
        </FlareNavLink>
        @* Directly after Repositories: it configures how they order each other. *@
        <FlareNavLink Href="/admin/default-plan">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Checklist" /></Icon>
            <ChildContent>@UiStrings.Nav_DefaultPlan</ChildContent>
        </FlareNavLink>
        <FlareNavLink Href="/admin/environments">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Dns" /></Icon>
            <ChildContent>@UiStrings.Nav_Environments</ChildContent>
        </FlareNavLink>
        @* Directly after Environments: environments and deploy targets both point at these rules. *@
        <FlareNavLink Href="/admin/readiness-rules">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Checklist" /></Icon>
            <ChildContent>@UiStrings.Nav_ReadinessRules</ChildContent>
        </FlareNavLink>
        @* Directly after Environments: it configures how repositories deploy to them. *@
        <FlareNavLink Href="/admin/deploy-targets">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.RocketLaunch" /></Icon>
            <ChildContent>@UiStrings.Nav_DeployTargets</ChildContent>
        </FlareNavLink>
        <FlareNavLink Href="/admin/action-handlers">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Notifications" /></Icon>
            <ChildContent>@UiStrings.Nav_ActionHandlers</ChildContent>
        </FlareNavLink>
        @* An overview of the connectors and handlers this build ships with. *@
        <FlareNavLink Href="/admin/plugins">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Extension" /></Icon>
            <ChildContent>@UiStrings.Nav_Plugins</ChildContent>
        </FlareNavLink>
        <FlareNavLink Href="/admin/permissions">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Lock" /></Icon>
            <ChildContent>@UiStrings.Nav_Permissions</ChildContent>
        </FlareNavLink>
        <FlareNavLink Href="/admin/request-audit">
            <Icon><FlareIconView Value="MaterialDesign3Icons.Regular.Monitoring" /></Icon>
            <ChildContent>@UiStrings.Nav_RequestAudit</ChildContent>
        </FlareNavLink>
    </FlareNavGroup>
</FlareNavMenu>
