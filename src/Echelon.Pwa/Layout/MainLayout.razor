@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@using Echelon.Pwa.Services.LocalAuth
@inject LanguageService Lang
@inject IConfiguration Config
@inject NavigationManager Nav
@inject IServiceProvider Services

<FlareLayout>
    <FlareLayoutAppBar DrawerToggle="true">
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Style="flex:1;min-width:0;">
            <FlareLink Href="/" Underline="LinkUnderline.None" Color="FlareColor.Default">
                <FlareText Typo="TypographyScale.TitleMedium" Weight="FontWeight.Bold">Echelon</FlareText>
            </FlareLink>
            <FlareSpacer />
            @* The project itself, one click away and outside AuthorizeView: the link is about the
               product, not about the session. Opened in a new tab so an operator mid-rollout does not
               lose the page they were watching. *@
            <FlareIconButton Href="@GitHubUrl" Target="_blank" Rel="noopener noreferrer"
                             AriaLabel="@UiStrings.Shell_GitHub">
                <FlareIconView Value="@(new FlareSvgIcon { Data = GitHubMark })" Size="1.35rem" />
            </FlareIconButton>
            @* Outside AuthorizeView: the language is picked before signing in as readily as after. *@
            <LanguageSwitcher />
            <AuthorizeView>
                <Authorized>
                    @* The Local provider has no RemoteAuthenticatorView, so authentication/logout does
                       nothing there and the token would never clear -- it needs its own handler. *@
                    @if (_isLocal)
                    {
                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="LogoutLocal">
                            <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Logout" /></LeadingIcon>
                            <ChildContent>@UiStrings.Shell_Logout</ChildContent>
                        </FlareButton>
                    }
                    else
                    {
                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Href="authentication/logout">
                            <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Logout" /></LeadingIcon>
                            <ChildContent>@UiStrings.Shell_Logout</ChildContent>
                        </FlareButton>
                    }
                </Authorized>
            </AuthorizeView>
        </FlareStack>
    </FlareLayoutAppBar>

    @* The drawer is gated on auth rather than NavMenu hiding its own contents: an empty rail next to
       the sign-in redirect is still a rail. *@
    <AuthorizeView>
        <Authorized>
            <FlareLayoutDrawer @bind-Open="_navOpen" Variant="DrawerVariant.Responsive" Width="16rem">
                <NavMenu />
            </FlareLayoutDrawer>
        </Authorized>
    </AuthorizeView>

    <FlareLayoutContent>
        @Body
    </FlareLayoutContent>
</FlareLayout>

@code {
    /// <summary>Where the product lives. A constant: it is the project's address, not a deployment's.</summary>
    const string GitHubUrl = "https://github.com/jrfrigat/echelon";

    /// <summary>The GitHub mark, 24x24 path data.</summary>
    /// <remarks>
    /// Local to the shell rather than in the icon pack, as the Flare gallery keeps its own: it is a
    /// third-party brand mark, not part of a design system, and a Material glyph in its place reads
    /// as "code" rather than as "the repository".
    /// </remarks>
    const string GitHubMark = "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";

    bool _navOpen = true;
    bool _isLocal;

    // LayoutComponentBase cannot inherit LocalizedComponent, so the subscription is by hand.
    protected override void OnInitialized()
    {
        _isLocal = string.Equals(Config["Auth:Provider"], "Local", StringComparison.OrdinalIgnoreCase);
        Lang.LanguageChanged += OnLanguageChanged;
    }

    // Clear the stored token and reboot at the login form. LocalAuthService is resolved lazily because
    // it is only registered under the Local provider; forceLoad restarts the app anonymous.
    async Task LogoutLocal()
    {
        await Services.GetRequiredService<LocalAuthService>().LogoutAsync();
        Nav.NavigateTo("login", forceLoad: true);
    }

    void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lang.LanguageChanged -= OnLanguageChanged;
}
