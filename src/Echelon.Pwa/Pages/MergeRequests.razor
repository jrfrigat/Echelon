@page "/merge-requests"
@attribute [Authorize]
@inherits PageBase
@inject WorkApi WorkApi
@inject EnvironmentsApi EnvironmentsApi

@* What there is to deploy, by task.

   A connector does not really report merge requests - it reports that a task has work in a
   repository, and a merge request is only what that work currently rides in. Before it is raised the
   work is a branch, and the task is the same either way. So a row here is (task, repository) and the
   merge request or branch is the carrier; a branch nothing has raised yet is New, which is the state
   a merge-request list could not show at all.

   Readiness is per environment because that is where it is decided: test may want one pipeline step,
   production another, another VCS a label. Pick the environment and the rows say where they stand
   against exactly the rule the launch gate will apply. *@

<AppTitle Title="@UiStrings.Work_Title" />

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.Work_Heading" />
    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@UiStrings.Work_Intro</FlareText>

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Start" Wrap>
                <FlareSelect TValue="Guid?" Label="@UiStrings.Work_Filter_Environment"
                             Value="_environmentId" ValueChanged="OnEnvironmentChanged"
                             Items="EnvironmentOptions" ItemLabel="@(EnvironmentLabel)" Style="min-width:14rem;" />
                <FlareSelect TValue="string" Label="@UiStrings.Work_Filter_State"
                             Value="_state" ValueChanged="OnStateChanged"
                             Items="StateOptions" ItemLabel="@(StateFilterLabel)" Style="min-width:11rem;" />
                <FlareTextField Label="@UiStrings.Work_Filter_Search" Value="_search"
                                ValueChanged="OnSearchChanged" Style="min-width:14rem;" />
                <div style="margin-top:1.5rem;">
                    <FlareButton Variant="ButtonVariant.Text" OnClick="Reload" Loading="_loading">
                        @UiStrings.Common_Refresh
                    </FlareButton>
                </div>
                <FlareSpacer />
                <div style="margin-top:1.5rem;">
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                        @string.Format(UiStrings.Work_Total, _total)
                    </FlareText>
                </div>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>

    @if (_truncated)
    {
        @* Said, not hidden: past the scan cap this list is a slice, and a slice that looks complete
           is the failure worth avoiding. *@
        <FlareAlert Severity="AlertSeverity.Warning">@UiStrings.Work_Truncated</FlareAlert>
    }

    @* Server-paged through the grid's provider, so the pager, the rows-per-page chooser and the
       column filter boxes are one request. The boxes narrow the same list the filter bar above does -
       they are AND-ed with it - and both are applied by the server, because this page holds one page. *@
    <FlareDataGrid TItem="WorkItemDto" @ref="_grid" ItemsProvider="LoadPage"
                   PageSize="GridDefaults.PageSize" RowsPerPageOptions="GridDefaults.RowsPerPage"
                   FilterMode="DataGridFilterMode.Simple" FilterPlaceholder="@UiStrings.Common_Filter"
                   Dense="true" Striped="true" Hoverable="true">
        <EmptyStateContent>
            <FlareEmptyState Title="@UiStrings.Work_Empty_Title" Description="@UiStrings.Work_Empty_Description" />
        </EmptyStateContent>
        <Columns>
            <FlareColumn TItem="WorkItemDto" Id="task" Title="@UiStrings.Work_Col_Task" Filterable="true">
                <Template>
                    @if (string.IsNullOrEmpty(context.TaskKey))
                    {
                        @* The linking rule matched nothing, so this work is in no plan. That is
                           the anomaly worth seeing, not a blank cell. *@
                        <FlareChip Size="ChipSize.Sm" Color="FlareColor.Warning" Label="@UiStrings.Work_NoTask" />
                    }
                    else
                    {
                        <FlareCode>@context.TaskKey</FlareCode>
                    }
                </Template>
            </FlareColumn>
            <FlareColumn TItem="WorkItemDto" Id="repo" Title="@UiStrings.Work_Col_Repository"
                         Field="@(w => (object?)w.RepositoryName)" Filterable="true" />
            <FlareColumn TItem="WorkItemDto" Id="carrier" Title="@UiStrings.Work_Col_Carrier" Filterable="true">
                <Template>
                    <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center" Wrap>
                        <FlareIconView Value="@(context.Kind == WorkItemKind.Branch
                                                ? MaterialDesign3Icons.Regular.AccountTree
                                                : MaterialDesign3Icons.Regular.CallMerge)" />
                        <FlareCode>@(context.Kind == WorkItemKind.Branch ? context.Branch : $"!{context.Carrier}")</FlareCode>
                    </FlareStack>
                </Template>
            </FlareColumn>
            <FlareColumn TItem="WorkItemDto" Id="state" Title="@UiStrings.Work_Col_State">
                <Template>
                    <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                        <FlareChip Size="ChipSize.Sm" Color="@StateColor(context.State)" Label="@StateLabel(context.State)" />
                        @if (context.IsStatusManual)
                        {
                            <FlareChip Size="ChipSize.Sm" Color="FlareColor.Secondary" Label="@UiStrings.Work_Pinned" />
                        }
                    </FlareStack>
                </Template>
            </FlareColumn>
            <FlareColumn TItem="WorkItemDto" Id="readiness" Title="@UiStrings.Work_Col_Readiness">
                <Template>
                    @if (_environmentId is null)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">-</FlareText>
                    }
                    else if (context.Readiness is not { } readiness)
                    {
                        @* No merge request, so there are no signals to judge. "Cannot say", which
                           is not the same as "not ready" and must not read as it. *@
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                            @UiStrings.Work_Readiness_NoMr
                        </FlareText>
                    }
                    else
                    {
                        <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center" Wrap>
                            <FlareChip Size="ChipSize.Sm" Color="@ReadinessColor(readiness.Status)"
                                       Label="@ReadinessLabel(readiness.Status)" />
                            @* Naming what is missing turns "no" into an instruction. *@
                            @foreach (var missing in readiness.MissingSignals)
                            {
                                <FlareCode>@missing</FlareCode>
                            }
                        </FlareStack>
                    }
                </Template>
            </FlareColumn>
        </Columns>
        </FlareDataGrid>
</FlareStack>

@code {
    FlareDataGrid<WorkItemDto>? _grid;
    List<EnvironmentDto>? _environments;

    // Kept from the last page load, because the header above the grid reports on the whole result:
    // how many rows matched, and whether the scan cap bound before they were counted.
    int _total;
    bool _truncated;
    bool _loading;
    Guid? _environmentId;
    string _state = "";
    string _search = "";

    // New is a branch nothing has raised; the rest are merge-request statuses. The retired ones are
    // absent: nothing writes them, so filtering by one could only ever return old rows.
    static readonly string[] StateOptions = ["", "New", "Opened", "Merged", "Closed"];

    IEnumerable<Guid?> EnvironmentOptions => [null, .. (_environments ?? []).Select(e => (Guid?)e.Id)];

    protected override async Task OnInitializedAsync() =>
        await RunAsync(async () => _environments = await EnvironmentsApi.GetEnvironmentsAsync());

    /// <summary>One page of work, narrowed by the filter bar and by the column filter boxes.</summary>
    async Task<DataGridResult<WorkItemDto>> LoadPage(DataGridRequest request)
    {
        _loading = true;
        try
        {
            return await LoadPageAsync(async () =>
            {
                var result = await WorkApi.GetWorkItemsAsync(
                    _environmentId,
                    string.IsNullOrEmpty(_state) ? null : _state,
                    string.IsNullOrWhiteSpace(_search) ? null : _search,
                    taskKey: request.Filter("task"),
                    repository: request.Filter("repo"),
                    connection: null,
                    branch: request.Filter("carrier"),
                    page: request.ApiPage(),
                    pageSize: request.PageSize);

                _total = result.Total;
                _truncated = result.Truncated;
                return new DataGridResult<WorkItemDto>(result.Items, result.Total);
            });
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Re-runs the query from the first page - what every filter above the grid does.</summary>
    /// <remarks>
    /// Back to page one on purpose: keeping the page number lands the operator on an empty page
    /// whenever the narrower filter has fewer pages than the old one.
    /// </remarks>
    async Task Reload()
    {
        if (_grid is not null) await _grid.GoToPageAsync(0);
    }

    async Task OnEnvironmentChanged(Guid? value) { _environmentId = value; await Reload(); }

    async Task OnStateChanged(string value) { _state = value; await Reload(); }

    async Task OnSearchChanged(string value) { _search = value; await Reload(); }

    string EnvironmentLabel(Guid? id) =>
        id is null
            ? UiStrings.Work_Filter_NoEnvironment
            : _environments?.FirstOrDefault(e => e.Id == id)?.Key ?? id.ToString()!;

    string StateFilterLabel(string state) =>
        string.IsNullOrEmpty(state) ? UiStrings.Work_Filter_AnyState : StateLabel(state);

    static string StateLabel(string state) => state switch
    {
        "New" => UiStrings.Work_State_New,
        "Opened" => UiStrings.Work_State_Opened,
        "Merged" => UiStrings.Work_State_Merged,
        "Closed" => UiStrings.Work_State_Closed,
        _ => state
    };

    static FlareColor StateColor(string state) => state switch
    {
        "New" => FlareColor.Tertiary,
        "Opened" => FlareColor.Primary,
        "Merged" => FlareColor.Success,
        "Closed" => FlareColor.Error,
        _ => FlareColor.OnSurfaceVariant
    };

    static string ReadinessLabel(WorkItemReadiness status) => status switch
    {
        WorkItemReadiness.Ready => UiStrings.Work_Ready,
        WorkItemReadiness.NotReady => UiStrings.Work_NotReady,
        WorkItemReadiness.Pinned => UiStrings.Work_Ready_Pinned,
        WorkItemReadiness.Held => UiStrings.Work_Held,
        WorkItemReadiness.Deployed => UiStrings.Work_Deployed,
        _ => UiStrings.Work_Ungated
    };

    static FlareColor ReadinessColor(WorkItemReadiness status) => status switch
    {
        WorkItemReadiness.Ready or WorkItemReadiness.Pinned => FlareColor.Success,
        WorkItemReadiness.Deployed => FlareColor.Secondary,
        WorkItemReadiness.Held or WorkItemReadiness.NotReady => FlareColor.Warning,
        _ => FlareColor.OnSurfaceVariant
    };
}
