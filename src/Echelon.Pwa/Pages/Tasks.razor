@page "/"
@attribute [Authorize]
@inherits PageBase
@inject TasksApi TasksApi

<AppTitle Title="@UiStrings.Tasks_Title" />

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.Tasks_Heading" />

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    @* Server-paged through the grid's own provider: the pager, the rows-per-page chooser and the
       column filter boxes arrive as one request, so a filter narrows the whole list rather than the
       page this screen happens to hold. Sorting stays off for that same reason - the server orders by
       key, and re-ordering 25 rows of N would look like ordering N. *@
    <FlareDataGrid TItem="TaskListItemDto" ItemsProvider="LoadPage"
                   PageSize="GridDefaults.PageSize" RowsPerPageOptions="GridDefaults.RowsPerPage"
                   FilterMode="DataGridFilterMode.Simple" FilterPlaceholder="@UiStrings.Common_Filter"
                   Dense="true" Striped="true" Hoverable="true">
        <EmptyStateContent>
            <FlareEmptyState Title="@UiStrings.Tasks_Empty_Title" Description="@UiStrings.Tasks_Empty_Description" />
        </EmptyStateContent>
        <Columns>
            <FlareColumn TItem="TaskListItemDto" Id="key" Title="@UiStrings.Tasks_Col_Key"
                         Field="@(t => (object?)t.ExternalId)" Filterable="true" />
            <FlareColumn TItem="TaskListItemDto" Id="title" Title="@UiStrings.Tasks_Col_Title"
                         Field="@(t => (object?)t.Title)" Filterable="true" />
            <FlareColumn TItem="TaskListItemDto" Id="status" Title="@UiStrings.Tasks_Col_Status"
                         Field="@(t => (object?)t.Status)" Filterable="true" />
            <FlareColumn TItem="TaskListItemDto" Id="mrs" Title="@UiStrings.Tasks_Col_Mrs"
                         Field="@(t => (object?)t.MergeRequestCount)" Align="ColumnAlign.End" />
            <FlareColumn TItem="TaskListItemDto" Id="plan" Title="@UiStrings.Tasks_Col_Plan">
                <Template>
                    @if (context.HasActivePlan)
                    {
                        <FlareChip Size="ChipSize.Sm" Color="FlareColor.Success" Label="@UiStrings.Tasks_PlanBuilt" />
                    }
                    else
                    {
                        <FlareChip Size="ChipSize.Sm" Label="@UiStrings.Tasks_PlanNone" />
                    }
                </Template>
            </FlareColumn>
            <FlareColumn TItem="TaskListItemDto" Id="actions" Title="" Align="ColumnAlign.End">
                <Template>
                    <FlareButton Size="ButtonSize.Sm" OnClick="@(() => Open(context.Id))">@UiStrings.Tasks_Open</FlareButton>
                </Template>
            </FlareColumn>
        </Columns>
    </FlareDataGrid>
</FlareStack>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    /// <summary>One page of tasks, narrowed by whatever the column filter boxes hold.</summary>
    async Task<DataGridResult<TaskListItemDto>> LoadPage(DataGridRequest request) =>
        await LoadPageAsync(async () =>
        {
            var page = await TasksApi.GetTasksAsync(
                request.ApiPage(), request.PageSize,
                key: request.Filter("key"),
                title: request.Filter("title"),
                status: request.Filter("status"));

            return new DataGridResult<TaskListItemDto>(page.Items, page.Total);
        });

    void Open(Guid id) => Nav.NavigateTo($"/tasks/{id}");
}
