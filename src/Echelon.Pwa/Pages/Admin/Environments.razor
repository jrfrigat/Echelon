@page "/admin/environments"
@attribute [Authorize]
@inherits PageBase
@inject ReadinessApi ReadinessApi
@inject EnvironmentsApi EnvironmentsApi

<AppTitle Title="@UiStrings.Env_Title" />

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.Env_Heading" />

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            @* A real form: Enter in any field adds the environment, as it does on every other
               add-form now. Aligned to the top so the inputs line up regardless of which fields
               carry a hint. *@
            <form @onsubmit="Create" @onsubmit:preventDefault>
                <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Start" Wrap>
                    <FlareTextField Label="@UiStrings.Env_Col_Key" @bind-Value="_key" Style="min-width:10rem;" />
                    <FlareTextField Label="@UiStrings.Env_Col_Name" @bind-Value="_name" Style="min-width:12rem;" />
                    @* Numeric, so the field is numeric: it used to be a text box that silently fell back to
                       0 when somebody typed a word, and the order decides the progression gate. *@
                    <FlareNumericField TValue="int" Label="@UiStrings.Env_Col_Order" @bind-Value="_order"
                                       Style="max-width:8rem;" />
                    <FlareSelect TValue="string" Label="@UiStrings.Env_ReadyRule_Label"
                                 @bind-Value="_ruleId" Items="RuleOptions" ItemLabel="@(RuleName)"
                                 Style="min-width:14rem;" />
                    <div style="margin-top:1.5rem;">
                        <FlareButton Type="ButtonType.Submit" Loading="_busy">@UiStrings.Env_Add</FlareButton>
                    </div>
                </FlareStack>
            </form>
        </FlareCardContent>
    </FlareCard>

    @if (_loading)
    {
        <FlareProgress Variant="ProgressVariant.Circular" />
    }
    else if (_envs is null || _envs.Count == 0)
    {
        <FlareEmptyState Title="@UiStrings.Env_Empty_Title" Description="@UiStrings.Env_Empty_Description" />
    }
    else
    {
        <FlareDataGrid TItem="EnvironmentDto" Items="_envs" Dense="true" Striped="true" Hoverable="true" ShowPager="false">
            <Columns>
                <FlareColumn TItem="EnvironmentDto" Id="key" Title="@UiStrings.Env_Col_Key"
                             Field="@(e => (object?)e.Key)" Sortable="true" Filterable="true" />
                <FlareColumn TItem="EnvironmentDto" Id="name" Title="@UiStrings.Env_Col_Name"
                             Field="@(e => (object?)e.Name)" Sortable="true" Filterable="true" />
                <FlareColumn TItem="EnvironmentDto" Id="order" Title="@UiStrings.Env_Col_Order"
                             Field="@(e => (object?)e.Order)" Sortable="true" Align="ColumnAlign.End" />
                <FlareColumn TItem="EnvironmentDto" Id="gate" Title="@UiStrings.Env_Col_Gate">
                    <Template>
                        @if (context.ReadinessRuleId is null)
                        {
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Secondary">@UiStrings.Env_Ungated</FlareText>
                        }
                        else
                        {
                            <FlareChip Size="ChipSize.Sm" Color="FlareColor.Primary" Label="@context.ReadinessRuleName" />
                        }
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="EnvironmentDto" Id="enabled" Title="@UiStrings.Env_Col_Enabled">
                    <Template>
                        <FlareChip Size="ChipSize.Sm" Color="@(context.IsEnabled ? FlareColor.Success : FlareColor.OnSurfaceVariant)" Label="@(context.IsEnabled ? UiStrings.Common_Yes : UiStrings.Common_No)" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="EnvironmentDto" Id="actions" Title="" Align="ColumnAlign.End">
                    <Template>
                        <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                            <FlareIconButton Size="ButtonSize.Sm"
                                             AriaLabel="@string.Format(UiStrings.Common_Edit_Aria, context.Key)"
                                             OnClick="@(() => OpenEdit(context))">
                                <FlareIconView Value="MaterialDesign3Icons.Regular.Edit" />
                            </FlareIconButton>
                            <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                             AriaLabel="@string.Format(UiStrings.Common_Delete_Aria, context.Key)"
                                             OnClick="@(() => Delete(context))">
                                <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                            </FlareIconButton>
                        </FlareStack>
                    </Template>
                </FlareColumn>
            </Columns>
        </FlareDataGrid>
    }
</FlareStack>

<FlareDialog Visible="_showEdit" Title="@UiStrings.Env_Dialog_Edit" VisibleChanged="@(v => _showEdit = v)">
    <ChildContent>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareTextField Label="@UiStrings.Env_Col_Name" @bind-Value="_eName" />
            <FlareNumericField TValue="int" Label="@UiStrings.Env_Col_Order" @bind-Value="_eOrder" Style="max-width:8rem;" />
            <FlareSwitch @bind-Value="_eEnabled" Label="@UiStrings.Env_Col_Enabled" />
            <FlareSelect TValue="string" Label="@UiStrings.Env_ReadyRule_Label"
                         @bind-Value="_eRuleId" Items="RuleOptions" ItemLabel="@(RuleName)" />
        </FlareStack>
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => _showEdit = false)">@UiStrings.Common_Cancel</FlareButton>
        <FlareButton OnClick="SaveEdit" Loading="_busy" Disabled="@string.IsNullOrWhiteSpace(_eName)">@UiStrings.Common_Save</FlareButton>
    </Actions>
</FlareDialog>

@code {
    // "" is the "no gate" option in the rule selector; any other value is a rule id.
    const string NoGate = "";

    List<EnvironmentDto>? _envs;
    List<ReadinessRuleDto> _rules = [];
    bool _loading = true;
    bool _busy;

    string _key = "";
    string _name = "";
    int _order;
    string _ruleId = NoGate;

    bool _showEdit;
    Guid _eId;
    string _eName = "";
    int _eOrder;
    bool _eEnabled = true;
    string _eRuleId = NoGate;

    // The selector's options: no gate first, then one per rule (by id).
    IEnumerable<string> RuleOptions => new[] { NoGate }.Concat(_rules.Select(r => r.Id.ToString()));

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        await RunAsync(async () =>
        {
            _rules = await ReadinessApi.GetReadinessRulesAsync();
            _envs = await EnvironmentsApi.GetEnvironmentsAsync();
        });
        _loading = false;
    }

    async Task Create()
    {
        // Enter submits too, and a keypress does not consult the button's disabled state.
        if (_busy || string.IsNullOrWhiteSpace(_key)) return;

        _busy = true;
        if (await RunAsync(
                async () => await EnvironmentsApi.CreateEnvironmentAsync(
                    _key.Trim(), _name.Trim(), _order, isEnabled: true, RuleIdOf(_ruleId)),
                UiStrings.Env_Created))
        {
            _key = ""; _name = ""; _order = 0; _ruleId = NoGate;
            await Load();
        }
        _busy = false;
    }

    void OpenEdit(EnvironmentDto env)
    {
        _eId = env.Id;
        _eName = env.Name;
        _eOrder = env.Order;
        _eEnabled = env.IsEnabled;
        _eRuleId = env.ReadinessRuleId?.ToString() ?? NoGate;
        _showEdit = true;
    }

    async Task SaveEdit()
    {
        _busy = true;
        if (await RunAsync(
                async () => await EnvironmentsApi.UpdateEnvironmentAsync(
                    _eId, _eName.Trim(), _eOrder, _eEnabled, RuleIdOf(_eRuleId)),
                UiStrings.Env_Updated))
        {
            _showEdit = false;
            await Load();
        }
        _busy = false;
    }

    async Task Delete(EnvironmentDto env)
    {
        if (!await ConfirmAsync(UiStrings.Env_Delete_Title, string.Format(UiStrings.Env_Delete_Message, env.Key))) return;
        if (await RunAsync(async () => await EnvironmentsApi.DeleteEnvironmentAsync(env.Id), UiStrings.Env_Deleted))
            await Load();
    }

    static Guid? RuleIdOf(string value) => Guid.TryParse(value, out var id) ? id : null;

    string RuleName(string value) =>
        value == NoGate
            ? UiStrings.Env_Rule_NoGate
            : _rules.FirstOrDefault(r => r.Id.ToString() == value)?.Name ?? value;
}
