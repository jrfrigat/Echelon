@page "/admin/repos"
@attribute [Authorize]
@inherits CrudPageBase<RepositoryDto>
@inject VcsApi VcsApi
@inject RepositoriesApi RepositoriesApi

<AppTitle Title="@UiStrings.Repos_Title" />

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.Repos_Title">
        <Actions>
            <FlareButton Size="ButtonSize.Sm" OnClick="OpenCreate">
                <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                <ChildContent>@UiStrings.Repos_New</ChildContent>
            </FlareButton>
        </Actions>
    </PageHeader>

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    @* The grid reads its own pages: the pager, the rows-per-page chooser and the column filter
       boxes come back as one request, and the server applies them - this screen only ever holds one
       page, so filtering here would search the slice and look like it had searched the list. *@
    <FlareDataGrid TItem="RepositoryDto" @ref="Grid" ItemsProvider="LoadPage" OnPageChanged="OnGridPageChanged"
                   PageSize="GridDefaults.PageSize" RowsPerPageOptions="GridDefaults.RowsPerPage"
                   FilterMode="DataGridFilterMode.Simple" FilterPlaceholder="@UiStrings.Common_Filter"
                   Dense="true" Striped="true" Hoverable="true">
        <Columns>
            <FlareColumn TItem="RepositoryDto" Id="name" Title="@UiStrings.Common_Name" Field="@(r => r.Name)" Filterable="true" />
            <FlareColumn TItem="RepositoryDto" Id="external" Title="@UiStrings.Repos_Col_ExternalId" Field="@(r => r.ExternalId)" Filterable="true" />
            <FlareColumn TItem="RepositoryDto" Id="connection" Title="@UiStrings.Repos_Col_Connection" Field="@(r => r.ConnectionName)" Filterable="true" />
            <FlareColumn TItem="RepositoryDto" Title="" Align="ColumnAlign.End">
                <Template>
                    <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                        <FlareIconButton AriaLabel="@string.Format(UiStrings.Common_Delete_Aria, context.Name)" Color="FlareColor.Error" OnClick="@(() => Delete(context))">
                            <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                        </FlareIconButton>
                    </FlareStack>
                </Template>
            </FlareColumn>
        </Columns>
    </FlareDataGrid>
</FlareStack>

<FlareDialog Visible="ShowModal" Title="@UiStrings.Repos_New" VisibleChanged="OnDialogVisibleChanged">
    <ChildContent>
        @* A form so Enter saves. The dialog renders its actions separately, so the Save button is not
           inside this element and cannot be the submit control - hence the hidden one at the end. *@
        <form @onsubmit="Save" @onsubmit:preventDefault>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareTextField Label="@UiStrings.Common_Name" @bind-Value="_fName" />
            <FlareTextField Label="@UiStrings.Repos_Col_ExternalId" @bind-Value="_fExternalId" Placeholder="@UiStrings.Repos_ExternalId_Placeholder" />
            @if (_connections is null)
            {
                <FlareProgress Variant="ProgressVariant.Circular" />
            }
            else
            {
                <FlareSelect TValue="Guid" Label="@UiStrings.Repos_Col_Connection" @bind-Value="_fConnectionId"
                             Items="@_connections.Items.Select(c => c.Id)"
                             ItemLabel="@(id => ConnectionLabel(id))" />
            }
        </FlareStack>
        <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
        </form>
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseModal">@UiStrings.Common_Cancel</FlareButton>
        <FlareButton OnClick="Save" Loading="Saving" Disabled="IsFormIncomplete">@UiStrings.Common_Save</FlareButton>
    </Actions>
</FlareDialog>

@code {
    PagedResult<VcsConnectionDto>? _connections;

    string _fName = "", _fExternalId = "";
    Guid _fConnectionId;

    /// <summary>Enter submits the dialog too, so the keyboard refuses what the disabled button does.</summary>
    protected override bool IsEditorIncomplete => IsFormIncomplete;

    bool IsFormIncomplete => string.IsNullOrWhiteSpace(_fName)
                             || string.IsNullOrWhiteSpace(_fExternalId)
                             || _fConnectionId == Guid.Empty;

    /// <inheritdoc/>
    protected override Task<PagedResult<RepositoryDto>> FetchPageAsync(DataGridRequest request) =>
        RepositoriesApi.GetRepositoriesAsync(
            request.ApiPage(), request.PageSize,
            name: request.Filter("name"),
            externalId: request.Filter("external"),
            connection: request.Filter("connection"));

    string ConnectionLabel(Guid id)
    {
        var c = _connections?.Items.FirstOrDefault(x => x.Id == id);
        return c is null ? id.ToString() : $"{c.Name} ({c.VcsType})";
    }

    async Task OpenCreate()
    {
        _fName = ""; _fExternalId = ""; _fConnectionId = Guid.Empty;
        ShowModal = true;

        if (_connections is not null) return;

        await RunAsync(async () => _connections = await VcsApi.GetVcsConnectionsAsync());
    }

    Task Save() => SaveAsync(
        () => RepositoriesApi.CreateRepositoryAsync(_fName, _fExternalId, _fConnectionId),
        UiStrings.Repos_Created);

    Task Delete(RepositoryDto r) =>
        DeleteAsync(string.Format(UiStrings.Repos_Delete_What, r.Name), () => RepositoriesApi.DeleteRepositoryAsync(r.Id));
}
