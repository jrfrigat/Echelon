@page "/admin/default-plan"
@attribute [Authorize]
@inherits PageBase

@* The rules are the input, the order is what they mean. Both are on one page on purpose: an
   operator adds "api after db" and needs to see immediately what the whole sequence became --
   a list of pairs does not read as a plan, and a contradictory pair does not announce itself. *@

<AppTitle Title="@UiStrings.DefaultPlan_Title" />

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@UiStrings.DefaultPlan_Title" />
    <FlareText Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
        @UiStrings.DefaultPlan_Description
    </FlareText>

    <PageAlerts Error="@Error" Success="@Success"
                OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

    @if (_loading)
    {
        <FlareProgress Variant="ProgressVariant.Circular" />
    }
    else
    {
        @* ---- the plan itself ---- *@
        <FlareText Typo="TypographyScale.TitleMedium">@UiStrings.DefaultPlan_Order_Title</FlareText>

        @if (_plan is null || _plan.Waves.Count == 0)
        {
            <FlareEmptyState Title="@UiStrings.DefaultPlan_NoRepos_Title"
                             Description="@UiStrings.DefaultPlan_NoRepos_Description" />
        }
        else
        {
            @if (_plan.Conflicts.Count > 0)
            {
                <FlareAlert Severity="AlertSeverity.Warning"
                            Title="@string.Format(UiStrings.DefaultPlan_Conflicts_Title, _plan.Conflicts.Count)">
                    <FlareStack Gap="FlareSpacing.XSmall">
                        <FlareText Typo="TypographyScale.BodySmall">@UiStrings.DefaultPlan_Conflicts_Body</FlareText>
                        @foreach (var c in _plan.Conflicts)
                        {
                            <FlareText Typo="TypographyScale.BodySmall">
                                @c.FromRepositoryName -> @c.ToRepositoryName: @c.Reason
                            </FlareText>
                        }
                    </FlareStack>
                </FlareAlert>
            }

            <FlareStack Gap="FlareSpacing.Small">
                @foreach (var wave in _plan.Waves)
                {
                    <FlareCard Variant="CardVariant.Outlined">
                        <FlareCardContent>
                            <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
                                <FlareChip Size="ChipSize.Sm" Color="FlareColor.Primary" Label="@string.Format(UiStrings.Plan_Wave, wave.Sequence)" />
                                @foreach (var repo in wave.Repositories)
                                {
                                    <FlareChip Size="ChipSize.Sm" Label="@repo.Name" />
                                }
                            </FlareStack>
                        </FlareCardContent>
                    </FlareCard>
                }
            </FlareStack>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                @UiStrings.DefaultPlan_Order_Hint
            </FlareText>
        }

        @* ---- the document, which is the source of truth ---- *@
        <FlareText Typo="TypographyScale.TitleMedium">@UiStrings.Rules_Title</FlareText>
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
            @UiStrings.Rules_Description
        </FlareText>

        @* Two ways in, one document. The form builds a model and the SERVER renders it into the same
           text the box below holds -- the editor never becomes a second source of truth, and anything
           the form cannot express keeps the text as the only way in. *@
        <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
            <FlareChip Size="ChipSize.Sm" Selected="@(!_visualEditor)" OnClick="@(() => SetEditor(false))"
                       Label="@UiStrings.Rules_Mode_Text" />
            <FlareChip Size="ChipSize.Sm" Selected="_visualEditor" OnClick="@(() => SetEditor(true))"
                       Label="@UiStrings.Rules_Mode_Visual" />
        </FlareStack>

        @if (_visualEditor)
        {
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardContent>
                    @if (_model is null)
                    {
                        <FlareProgress Variant="ProgressVariant.Circular" />
                    }
                    else if (!_model.Editable)
                    {
                        @* Refused rather than offered with parts missing: saving from the form would
                           drop what it cannot hold, and silently deleting a rule is worse than
                           telling somebody to use the text box. *@
                        <FlareAlert Severity="AlertSeverity.Info" Title="@UiStrings.Rules_Visual_Unavailable">
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareText Typo="TypographyScale.BodySmall">@UiStrings.Rules_Visual_Unavailable_Body</FlareText>
                                @foreach (var problem in _model.Problems)
                                {
                                    <FlareText Typo="TypographyScale.BodySmall">@problem</FlareText>
                                }
                            </FlareStack>
                        </FlareAlert>
                    }
                    else
                    {
                        <FlareStack Gap="FlareSpacing.Medium">
                            @* ---- groups: what each name selects ---- *@
                            <FlareText Typo="TypographyScale.TitleSmall">@UiStrings.Rules_Visual_Groups</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                @UiStrings.Rules_Visual_Groups_Hint
                            </FlareText>

                            @foreach (var group in _model.Groups)
                            {
                                <FlareCard Variant="CardVariant.Filled">
                                    <FlareCardContent>
                                        <FlareStack Gap="FlareSpacing.Small">
                                            <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End">
                                                <FlareTextField Label="@UiStrings.Rules_Visual_GroupName"
                                                                Value="@group.Name"
                                                                ValueChanged="@(v => group.Name = v ?? "")"
                                                                Style="min-width:12rem;" />
                                                <FlareSpacer />
                                                <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                                                 AriaLabel="@UiStrings.Rules_Visual_RemoveGroup"
                                                                 OnClick="@(() => _model.Groups.Remove(group))">
                                                    <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                                                </FlareIconButton>
                                            </FlareStack>
                                            <FlareStack Row Gap="FlareSpacing.Small" Wrap>
                                                <FlareTextField Label="@UiStrings.Rules_Visual_Repositories"
                                                                Value="@Join(group.Repositories)"
                                                                ValueChanged="@(v => group.Repositories = Split(v))"
                                                                Style="min-width:16rem;" />
                                                <FlareTextField Label="@UiStrings.Rules_Visual_Connectors"
                                                                Value="@Join(group.Connectors)"
                                                                ValueChanged="@(v => group.Connectors = Split(v))"
                                                                Style="min-width:12rem;" />
                                                <FlareTextField Label="@UiStrings.Rules_Visual_Branches"
                                                                Value="@Join(group.Branches)"
                                                                ValueChanged="@(v => group.Branches = Split(v))"
                                                                Style="min-width:12rem;" />
                                                <FlareTextField Label="@UiStrings.Rules_Visual_TaskKeys"
                                                                Value="@Join(group.TaskKeys)"
                                                                ValueChanged="@(v => group.TaskKeys = Split(v))"
                                                                Style="min-width:12rem;" />
                                                <FlareTextField Label="@UiStrings.Rules_Visual_Labels"
                                                                Value="@Join(group.Labels)"
                                                                ValueChanged="@(v => group.Labels = Split(v))"
                                                                Style="min-width:12rem;" />
                                            </FlareStack>
                                        </FlareStack>
                                    </FlareCardContent>
                                </FlareCard>
                            }

                            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" OnClick="AddGroup">
                                <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                                <ChildContent>@UiStrings.Rules_Visual_AddGroup</ChildContent>
                            </FlareButton>

                            @* ---- order: which group waits for which ---- *@
                            <FlareText Typo="TypographyScale.TitleSmall">@UiStrings.Rules_Visual_Order</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                @UiStrings.Rules_Visual_Order_Hint
                            </FlareText>

                            @foreach (var rule in _model.Order)
                            {
                                <FlareCard Variant="CardVariant.Filled">
                                    <FlareCardContent>
                                        <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End" Wrap>
                                            <FlareSelect TValue="string" Label="@UiStrings.Rules_Visual_Group"
                                                         Value="@rule.Group" ValueChanged="@(v => rule.Group = v ?? "")"
                                                         Items="@GroupNames" Style="min-width:10rem;" />
                                            <FlareTextField Label="@UiStrings.Rules_Visual_Needs"
                                                            Value="@Join(rule.Needs)"
                                                            ValueChanged="@(v => rule.Needs = Split(v))"
                                                            Style="min-width:14rem;" />
                                            <FlareSelect TValue="string" Label="@UiStrings.DefaultPlan_Col_Type"
                                                         Value="@rule.Type" ValueChanged="@(v => rule.Type = v ?? "Hard")"
                                                         Items="@(new[] { "Hard", "Soft" })"
                                                         ItemLabel="@(t => t == "Hard" ? UiStrings.DefaultPlan_Type_Hard : UiStrings.DefaultPlan_Type_Soft)" />
                                            <FlareSelect TValue="string" Label="@UiStrings.Rules_Visual_Scope"
                                                         Value="@rule.Scope" ValueChanged="@(v => rule.Scope = v ?? "AcrossPlan")"
                                                         Items="@(new[] { "AcrossPlan", "WithinTask" })"
                                                         ItemLabel="@(s => s == "WithinTask" ? UiStrings.Rules_Visual_Scope_WithinTask : UiStrings.Rules_Visual_Scope_AcrossPlan)" />
                                            <FlareSpacer />
                                            <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                                             AriaLabel="@UiStrings.Rules_Visual_RemoveRule"
                                                             OnClick="@(() => _model.Order.Remove(rule))">
                                                <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                                            </FlareIconButton>
                                        </FlareStack>
                                    </FlareCardContent>
                                </FlareCard>
                            }

                            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined"
                                         OnClick="AddRule" Disabled="@(_model.Groups.Count == 0)">
                                <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                                <ChildContent>@UiStrings.Rules_Visual_AddRule</ChildContent>
                            </FlareButton>

                            <FlareStack Row Gap="FlareSpacing.Small" Wrap>
                                @* Preview before save, because what is being written is the deploy
                                   order of every rollout in the installation. *@
                                <FlareButton Variant="ButtonVariant.Outlined" OnClick="PreviewModel" Loading="_validating">
                                    @UiStrings.Rules_Visual_Preview
                                </FlareButton>
                                <FlareButton OnClick="SaveModel" Loading="_savingRules">@UiStrings.Common_Save</FlareButton>
                            </FlareStack>
                        </FlareStack>
                    }
                </FlareCardContent>
            </FlareCard>
        }

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardContent>
                <FlareStack Gap="FlareSpacing.Small">
                    @* The document itself stays editable as text whichever mode is on: the language
                       says things no form will (nested excludes, per-task policy), and the form
                       renders INTO this box so the two never disagree about what is stored. *@
                    <FlareTextArea Label="@UiStrings.Rules_Document_Label" @bind-Value="_document"
                                   Rows="16" Style="font-family:monospace;" />

                    <FlareStack Row Gap="FlareSpacing.Small" Wrap>
                        <FlareButton Variant="ButtonVariant.Outlined" OnClick="ValidateRules" Loading="_validating">
                            @UiStrings.Rules_Validate
                        </FlareButton>
                        <FlareButton OnClick="SaveRules" Loading="_savingRules">@UiStrings.Common_Save</FlareButton>
                        @if (_rules is { Count: > 0 } && string.IsNullOrWhiteSpace(_document))
                        {
                            @* Only offered while there is something to adopt and nothing written yet:
                               it overwrites the box, and doing that over an operator's draft would be
                               its own kind of rude. *@
                            <FlareButton Variant="ButtonVariant.Text" OnClick="AdoptFromScreen">
                                @UiStrings.Rules_Adopt
                            </FlareButton>
                        }
                    </FlareStack>

                    @if (_validation is not null)
                    {
                        @if (_validation.Problems.Count > 0)
                        {
                            <FlareAlert Severity="AlertSeverity.Error" Title="@UiStrings.Rules_Invalid">
                                <FlareStack Gap="FlareSpacing.XSmall">
                                    @foreach (var problem in _validation.Problems)
                                    {
                                        <FlareText Typo="TypographyScale.BodySmall">@problem</FlareText>
                                    }
                                </FlareStack>
                            </FlareAlert>
                        }
                        else
                        {
                            @* The counts are the useful half: a document can be valid and select
                               nothing, because a glob with a typo is still a well-formed glob. *@
                            <FlareAlert Severity="AlertSeverity.Success" Title="@UiStrings.Rules_Valid" />
                            @if (_validation.Groups.Count > 0)
                            {
                                <FlareDataGrid TItem="OrderingRuleGroupMatchDto" Items="_validation.Groups"
                                               Dense="true" Striped="true" ShowPager="false">
                                    <Columns>
                                        <FlareColumn TItem="OrderingRuleGroupMatchDto" Id="group" Title="@UiStrings.Rules_Col_Group"
                                                     Field="@(g => (object?)g.Group)" />
                                        <FlareColumn TItem="OrderingRuleGroupMatchDto" Id="matched" Title="@UiStrings.Rules_Col_Matched">
                                            <Template>
                                                <FlareChip Size="ChipSize.Sm"
                                                           Color="@(context.Matched == 0 ? FlareColor.Warning : FlareColor.Primary)"
                                                           Label="@context.Matched.ToString()" />
                                            </Template>
                                        </FlareColumn>
                                        <FlareColumn TItem="OrderingRuleGroupMatchDto" Id="examples" Title="@UiStrings.Rules_Col_Examples">
                                            <Template>
                                                <FlareStack Row Gap="FlareSpacing.XSmall" Wrap>
                                                    @foreach (var example in context.Examples)
                                                    {
                                                        <FlareCode>@example</FlareCode>
                                                    }
                                                </FlareStack>
                                            </Template>
                                        </FlareColumn>
                                    </Columns>
                                </FlareDataGrid>
                            }
                        }
                    }
                </FlareStack>
            </FlareCardContent>
        </FlareCard>

        @* ---- the pair rules, which the document supersedes ---- *@
        <FlareText Typo="TypographyScale.TitleMedium">@UiStrings.DefaultPlan_Rules_Title</FlareText>

        @if (DocumentOwnsOrdering)
        {
            <FlareAlert Severity="AlertSeverity.Info" Title="@UiStrings.Rules_Owns_Title">
                @UiStrings.Rules_Owns_Body
            </FlareAlert>
        }

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardContent>
                @if (DocumentOwnsOrdering)
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                        @UiStrings.Rules_Owns_ReadOnly
                    </FlareText>
                }
                else if (_repositories is null || _repositories.Count < 2)
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                        @UiStrings.DefaultPlan_NeedTwoRepos
                    </FlareText>
                }
                else
                {
                    <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End">
                        <FlareSelect TValue="Guid" Label="@UiStrings.DefaultPlan_Col_From" @bind-Value="_fFrom"
                                     Items="@_repositories.Select(r => r.Id)"
                                     ItemLabel="@(id => RepositoryName(id))" />
                        <FlareSelect TValue="Guid" Label="@UiStrings.DefaultPlan_Col_After" @bind-Value="_fTo"
                                     Items="@_repositories.Select(r => r.Id)"
                                     ItemLabel="@(id => RepositoryName(id))" />
                        <FlareSelect TValue="string" Label="@UiStrings.DefaultPlan_Col_Type" @bind-Value="_fType"
                                     Items="@(new[] { "Hard", "Soft" })"
                                     ItemLabel="@(t => t == "Hard" ? UiStrings.DefaultPlan_Type_Hard : UiStrings.DefaultPlan_Type_Soft)" />
                        <FlareButton OnClick="Create" Loading="_busy" Disabled="IsFormIncomplete">
                            @UiStrings.DefaultPlan_Add
                        </FlareButton>
                    </FlareStack>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                        @UiStrings.DefaultPlan_Type_Hint
                    </FlareText>
                }
            </FlareCardContent>
        </FlareCard>

        @if (_rules is null || _rules.Count == 0)
        {
            <FlareEmptyState Title="@UiStrings.DefaultPlan_NoRules_Title"
                             Description="@UiStrings.DefaultPlan_NoRules_Description" />
        }
        else
        {
            <FlareDataGrid TItem="RepositoryOrderingDto" Items="_rules" Dense="true" Striped="true" Hoverable="true" ShowPager="false">
                <Columns>
                    <FlareColumn TItem="RepositoryOrderingDto" Id="from" Title="@UiStrings.DefaultPlan_Col_From"
                                 Field="@(r => (object?)r.FromRepositoryName)" Sortable="true" Filterable="true" />
                    <FlareColumn TItem="RepositoryOrderingDto" Id="after" Title="@UiStrings.DefaultPlan_Col_After"
                                 Field="@(r => (object?)r.ToRepositoryName)" Sortable="true" Filterable="true" />
                    <FlareColumn TItem="RepositoryOrderingDto" Id="type" Title="@UiStrings.DefaultPlan_Col_Type"
                                 Field="@(r => (object?)r.Type)" Sortable="true">
                        <Template>
                            <FlareChip Size="ChipSize.Sm" Color="@(context.Type == "Hard" ? FlareColor.Primary : FlareColor.Default)" Label="@(context.Type == "Hard" ? UiStrings.DefaultPlan_Type_Hard : UiStrings.DefaultPlan_Type_Soft)" />
                        </Template>
                    </FlareColumn>
                    <FlareColumn TItem="RepositoryOrderingDto" Id="actions" Title="" Align="ColumnAlign.End">
                        <Template>
                            @* Disabled rather than hidden while the document owns ordering: an absent
                               button reads as "cannot be removed", a disabled one as "not from here",
                               and the alert above says where from. *@
                            <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error"
                                             Disabled="DocumentOwnsOrdering"
                                             AriaLabel="@string.Format(UiStrings.Common_Delete_Aria, $"{context.FromRepositoryName} / {context.ToRepositoryName}")"
                                             OnClick="@(() => Delete(context))">
                                <FlareIconView Value="MaterialDesign3Icons.Regular.Delete" />
                            </FlareIconButton>
                        </Template>
                    </FlareColumn>
                </Columns>
            </FlareDataGrid>
        }
    }
</FlareStack>

@code {
    List<RepositoryOrderingDto>? _rules;
    List<RepositoryDto>? _repositories;
    DefaultPlanDto? _plan;
    bool _loading = true;
    bool _busy;

    Guid _fFrom;
    Guid _fTo;
    string _fType = "Hard";

    string _document = "";
    string _savedDocument = "";
    OrderingRulesValidationDto? _validation;
    bool _validating;
    bool _savingRules;

    bool IsFormIncomplete => _fFrom == Guid.Empty || _fTo == Guid.Empty || _fFrom == _fTo;

    /// <summary>
    /// Whether a saved document is in force, which makes the pair rules read-only.
    /// </summary>
    /// <remarks>
    /// Keyed on what is SAVED, not on what is in the box: typing into the editor must not disable the
    /// rules below before anything has been committed, and clearing the box must not re-enable them
    /// until that clearing is saved.
    /// </remarks>
    bool DocumentOwnsOrdering => !string.IsNullOrWhiteSpace(_savedDocument);

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        await RunAsync(async () =>
        {
            _rules = (await Api.GetRepositoryOrderingAsync()).Items;
            _repositories = (await Api.GetRepositoriesAsync()).Items;
            _savedDocument = (await Api.GetOrderingRulesAsync()).Document;
            _document = _savedDocument;
            // Read after the rules, so it reflects whatever was just added or removed.
            _plan = await Api.GetDefaultPlanAsync();
        });
        _loading = false;
    }

    string RepositoryName(Guid id) =>
        _repositories?.FirstOrDefault(r => r.Id == id)?.Name ?? id.ToString();

    async Task ValidateRules()
    {
        _validating = true;
        await RunAsync(async () => _validation = await Api.ValidateOrderingRulesAsync(_document));
        _validating = false;
    }

    async Task SaveRules()
    {
        _savingRules = true;

        // Validated first so a refusal arrives as the list of problems rather than as one API error
        // with the rest hidden behind it.
        await RunAsync(async () => _validation = await Api.ValidateOrderingRulesAsync(_document));

        if (_validation is { IsValid: true }
            && await RunAsync(() => Api.SaveOrderingRulesAsync(_document), UiStrings.Rules_Saved))
        {
            await Load();
        }

        _savingRules = false;
    }

    // ---- visual editor ------------------------------------------------------------------------

    bool _visualEditor;
    OrderingRulesModelDto? _model;

    IEnumerable<string> GroupNames => _model?.Groups.Select(g => g.Name) ?? [];

    /// <summary>
    /// Switches between editing the document as text and building it from a form.
    /// </summary>
    /// <remarks>
    /// The model is fetched on every switch rather than cached, so the form always starts from what
    /// is STORED. Starting from an unsaved edit in the text box would give the form a document the
    /// server never parsed, and it is the server's parse that decides what a rule means.
    /// </remarks>
    async Task SetEditor(bool visual)
    {
        _visualEditor = visual;
        if (visual) await RunAsync(async () => _model = await Api.GetOrderingRulesModelAsync());
    }

    void AddGroup() => _model?.Groups.Add(new OrderingRuleGroupDto { Name = "" });

    void AddRule() =>
        _model?.Order.Add(new OrderingRuleOrderDto { Group = _model.Groups.FirstOrDefault()?.Name ?? "" });

    /// <summary>Renders the form into the text box, so what will be saved can be read first.</summary>
    async Task PreviewModel()
    {
        if (_model is null) return;
        _validating = true;
        if (await RunAsync(async () => _document = (await Api.RenderOrderingRulesModelAsync(_model)).Document))
            await ValidateRules();
        _validating = false;
    }

    /// <summary>Renders the form and stores it, through the same gate the text editor uses.</summary>
    async Task SaveModel()
    {
        if (_model is null) return;
        _savingRules = true;
        if (await RunAsync(() => Api.SaveOrderingRulesModelAsync(_model), UiStrings.Rules_Saved))
        {
            await Load();
            await RunAsync(async () => _model = await Api.GetOrderingRulesModelAsync());
        }
        _savingRules = false;
    }

    /// <summary>
    /// A list as one comma-separated field, and back.
    /// </summary>
    /// <remarks>
    /// Globs and labels are short and are usually pasted from somewhere else, so one field beats a
    /// row of chips with an add button. Blank entries are dropped on the way in: a trailing comma is
    /// how everyone types a list, and an empty glob would silently match nothing.
    /// </remarks>
    static string Join(IEnumerable<string>? values) => string.Join(", ", values ?? []);

    static List<string> Split(string? value) =>
        [.. (value ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

    /// <summary>Fills the editor with a document equivalent to the rules configured on screen.</summary>
    /// <remarks>
    /// Loaded, not saved: adopting the document turns those rules read-only, so the operator reads
    /// what they are about to make authoritative first. It is also where a rule nobody remembers
    /// adding tends to be noticed.
    /// </remarks>
    async Task AdoptFromScreen()
    {
        if (await RunAsync(async () => _document = (await Api.OrderingRulesFromScreenAsync()).Document))
            await ValidateRules();
    }

    async Task Create()
    {
        _busy = true;
        if (await RunAsync(
                () => Api.CreateRepositoryOrderingAsync(_fFrom, _fTo, _fType),
                UiStrings.DefaultPlan_Created))
        {
            _fFrom = Guid.Empty;
            _fTo = Guid.Empty;
            await Load();
        }
        _busy = false;
    }

    async Task Delete(RepositoryOrderingDto rule)
    {
        var what = $"{rule.FromRepositoryName} -> {rule.ToRepositoryName}";
        if (!await ConfirmAsync(UiStrings.DefaultPlan_Delete_Title, string.Format(UiStrings.DefaultPlan_Delete_Message, what)))
            return;

        if (await RunAsync(() => Api.DeleteRepositoryOrderingAsync(rule.Id), UiStrings.DefaultPlan_Deleted))
            await Load();
    }
}
