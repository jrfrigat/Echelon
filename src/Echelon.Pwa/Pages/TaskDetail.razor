@page "/tasks/{Id:guid}"
@attribute [Authorize]
@inherits PageBase
@inject TasksApi TasksApi
@inject RolloutsApi RolloutsApi
@inject ReadinessApi ReadinessApi
@inject EnvironmentsApi EnvironmentsApi

<AppTitle Title="@(_task?.ExternalId ?? _plan?.TargetTaskKey ?? UiStrings.Tasks_Title)" />

<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
    <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="Back">
        <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.ArrowBack" /></LeadingIcon>
        <ChildContent>@UiStrings.TaskDetail_Back</ChildContent>
    </FlareButton>
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">@(_task?.ExternalId ?? _plan?.TargetTaskKey ?? "")</FlareText>
    <FlareSpacer />
    <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="@(() => Nav.NavigateTo($"/tasks/{Id}/timeline"))">
        <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Schedule" /></LeadingIcon>
        <ChildContent>@UiStrings.Timeline_Title</ChildContent>
    </FlareButton>
    @* Only once a plan exists: there is nothing to export before that, and a button that answers
       "no plan" is a worse way to learn it than the Build button already on the page. *@
    @if (_plan is not null)
    {
        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="ShowYaml" Disabled="_busy">
            <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Description" /></LeadingIcon>
            <ChildContent>@UiStrings.TaskDetail_Yaml</ChildContent>
        </FlareButton>
    }
    <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" OnClick="Recalculate" Disabled="_busy">
        <LeadingIcon><FlareIconView Value="MaterialDesign3Icons.Regular.Refresh" /></LeadingIcon>
        <ChildContent>@UiStrings.TaskDetail_Recalculate</ChildContent>
    </FlareButton>
</FlareStack>

@* Shown rather than downloaded: the point is reading the tree and diffing it against what was
   expected, and a file in the downloads folder is a worse place to do that from. *@
<FlareDialog Visible="_showYaml" Title="@UiStrings.TaskDetail_Yaml_Title" VisibleChanged="@(v => _showYaml = v)">
    <ChildContent>
        <FlareTextArea Value="@_yaml" Rows="22" ReadOnly="true" Style="font-family:monospace;" />
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => _showYaml = false)">@UiStrings.Common_Close</FlareButton>
    </Actions>
</FlareDialog>

<PageAlerts Error="@Error" Success="@Success"
            OnErrorDismiss="@(() => Error = null)" OnSuccessDismiss="@(() => Success = null)" />

@* The hierarchy is a fact about the task, not about a plan, so it renders whether or not one was
   ever built -- and a subtask's parent never appears in its own plan tree (a task does not wait on
   its parent), which makes this the only place it is visible at all. *@
@if (!_loading && _task is not null && (_task.Parent is not null || _task.Children.Count > 0))
{
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @if (_task.Parent is not null)
                {
                    <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@UiStrings.TaskDetail_Parent</FlareText>
                        <FlareChip Size="ChipSize.Sm" OnClick="@(() => Open(_task.Parent.Id))" Label="@_task.Parent.ExternalId" />
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@_task.Parent.Title</FlareText>
                    </FlareStack>
                }
                @if (_task.Children.Count > 0)
                {
                    <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@UiStrings.TaskDetail_Children</FlareText>
                        @foreach (var child in _task.Children)
                        {
                            var childId = child.Id;
                            <FlareChip Size="ChipSize.Sm" OnClick="@(() => Open(childId))" Label="@child.ExternalId" />
                        }
                    </FlareStack>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                        @UiStrings.TaskDetail_Children_Hint
                    </FlareText>
                }
            </FlareStack>
        </FlareCardContent>
    </FlareCard>
}

@if (_loading)
{
    <FlareProgress Variant="ProgressVariant.Circular" />
}
else if (_plan is null)
{
    <FlareEmptyState Title="@UiStrings.TaskDetail_NoPlan_Title" Description="@UiStrings.TaskDetail_NoPlan_Description" />
    <FlareButton OnClick="Recalculate" Loading="_busy">@UiStrings.TaskDetail_Build</FlareButton>
}
else
{
    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
        @string.Format(UiStrings.TaskDetail_Meta, _plan.Version, _plan.Source, _plan.UpdatedAt.ToString("g"))
    </FlareText>

    @* Gated on the ENABLED set, not the raw list. Environments that all happen to be disabled left
       the picker with no options and a default Guid.Empty selection, rendering an all-zeros id and
       offering a Launch button that could only fail. *@
    <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.End">
        @if (EnabledEnvironments is { Count: > 0 } enabled)
        {
            <FlareSelect TValue="Guid" Label="@UiStrings.TaskDetail_Environment"
                         @bind-Value="_selectedEnvironmentId"
                         Items="@enabled.Select(e => e.Id)"
                         ItemLabel="@(id => EnvironmentLabel(id))"
                         Style="min-width:14rem;" />
            <FlareButton OnClick="Launch" Loading="_busy"
                         Disabled="@(_plan.Conflicts.Count > 0 || _selectedEnvironmentId == Guid.Empty)">
                @UiStrings.TaskDetail_Launch
            </FlareButton>
            @* Off by default: a redeploy only happens with both this and a target that permits it. *@
            <FlareSwitch @bind-Value="_redeploy" Label="@UiStrings.TaskDetail_Redeploy" />
        }
        else
        {
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@UiStrings.TaskDetail_NoEnvironments</FlareText>
        }
    </FlareStack>

    @if (_plan.Conflicts.Count > 0)
    {
        <FlareAlert Severity="AlertSeverity.Warning"
                    Title="@string.Format(UiStrings.Plan_Conflicts_Title, _plan.Conflicts.Count)">
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Typo="TypographyScale.BodySmall">@UiStrings.Plan_Conflicts_Body</FlareText>
                @foreach (var c in _plan.Conflicts)
                {
                    <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                        <FlareChip Size="ChipSize.Sm" Color="FlareColor.Warning" Label="@c.Kind" />
                        <FlareText Typo="TypographyScale.BodySmall">@c.Reason</FlareText>
                    </FlareStack>
                }
            </FlareStack>
        </FlareAlert>
    }

    <FlareText Typo="TypographyScale.TitleMedium">@UiStrings.TaskDetail_Tree_Title</FlareText>
    <FlareStack Gap="FlareSpacing.Medium">
        @foreach (var node in _plan.Nodes)
        {
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader>
                    <ChildContent>
                        <FlareStack Gap="FlareSpacing.XSmall">
                            <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                                <FlareText Typo="TypographyScale.TitleSmall">@node.TaskKey</FlareText>
                                @if (node.IsTarget)
                                {
                                    <FlareChip Size="ChipSize.Sm" Color="FlareColor.Primary" Label="@UiStrings.TaskDetail_Target" />
                                }
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@node.TaskTitle</FlareText>
                            </FlareStack>
                            @if (node.DependsOnTaskIds.Count > 0)
                            {
                                <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@UiStrings.TaskDetail_DependsOn</FlareText>
                                    @foreach (var dep in node.DependsOnTaskIds)
                                    {
                                        <FlareChip Size="ChipSize.Sm" Label="@KeyOf(dep)" />
                                    }
                                </FlareStack>
                            }
                        </FlareStack>
                    </ChildContent>
                </FlareCardHeader>

                <FlareCardContent>
                    @if (node.Items.Count == 0)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@UiStrings.TaskDetail_NoItems</FlareText>
                    }
                    else
                    {
                        <FlareStack Gap="FlareSpacing.XSmall">
                            @foreach (var item in node.Items)
                            {
                                <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
                                    <FlareChip Size="ChipSize.Sm" Label="@string.Format(UiStrings.Plan_Wave, item.Wave)" />
                                    <FlareChip Size="ChipSize.Sm" Color="@StatusColor(item.MrStatus)" Label="@item.MrStatus" />
                                    @if (item.ManuallyIncluded)
                                    {
                                        @* The one row in the plan that does not follow from the atlas. *@
                                        <FlareChip Size="ChipSize.Sm" Color="FlareColor.Warning" Label="@UiStrings.Plan_Membership_Forced" />
                                    }
                                    <FlareStack Gap="FlareSpacing.None">
                                        <FlareText Typo="TypographyScale.BodyMedium">@item.RepositoryName !@item.MrExternalId</FlareText>
                                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                            @item.SourceBranch -> @item.TargetBranch
                                        </FlareText>
                                    </FlareStack>
                                    <FlareSpacer />
                                    @* The readiness escape hatch: pin this merge request ready or held for an
                                       environment, overriding its labels -- needed when a merged MR's approval
                                       could not be observed. *@
                                    <FlareIconButton Size="ButtonSize.Sm" AriaLabel="@string.Format(UiStrings.Pin_Aria, item.MrExternalId)"
                                                     OnClick="@(() => OpenPins(item.MergeRequestId, item.MrExternalId))">
                                        <FlareIconView Value="MaterialDesign3Icons.Regular.Approval" />
                                    </FlareIconButton>
                                    @* Membership: keep this merge request out of the rollout without touching
                                       it in the provider. Stored as a delta on the task, so it survives the
                                       rebuild that every ingestion event triggers. *@
                                    <FlareIconButton Size="ButtonSize.Sm" Color="FlareColor.Error" Disabled="_busy"
                                                     AriaLabel="@string.Format(UiStrings.Plan_Membership_Exclude_Aria, item.MrExternalId)"
                                                     OnClick="@(() => SetMembership(item.MergeRequestId, "excluded"))">
                                        <FlareIconView Value="MaterialDesign3Icons.Regular.Block" />
                                    </FlareIconButton>
                                </FlareStack>
                            }
                        </FlareStack>
                    }
                </FlareCardContent>
            </FlareCard>
        }
    </FlareStack>
}

@* Excluded work is invisible in the tree by construction, so it is listed here. Without this the
   exclude button would be a one-way door. *@
@if (_membership.Count > 0)
{
    <FlareText Typo="TypographyScale.TitleMedium">@UiStrings.Plan_Membership_Title</FlareText>
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                    @UiStrings.Plan_Membership_Intro
                </FlareText>
                @foreach (var entry in _membership)
                {
                    <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
                        <FlareChip Size="ChipSize.Sm"
                                   Color="@(entry.State == "Excluded" ? FlareColor.Error : FlareColor.Warning)"
                                   Label="@(entry.State == "Excluded" ? UiStrings.Plan_Membership_Excluded : UiStrings.Plan_Membership_Included)" />
                        <FlareChip Size="ChipSize.Sm" Color="@StatusColor(entry.MrStatus)" Label="@entry.MrStatus" />
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Typo="TypographyScale.BodyMedium">@entry.RepositoryName !@entry.MrExternalId</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@entry.SourceBranch</FlareText>
                        </FlareStack>
                        <FlareSpacer />
                        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" Disabled="_busy"
                                     OnClick="@(() => SetMembership(entry.MergeRequestId, "auto"))">
                            @UiStrings.Plan_Membership_Restore
                        </FlareButton>
                    </FlareStack>
                }
            </FlareStack>
        </FlareCardContent>
    </FlareCard>
}

<FlareDialog Visible="_showPins" Title="@string.Format(UiStrings.Pin_Dialog_Title, _pinMrExternalId)"
             VisibleChanged="@(v => _showPins = v)">
    <ChildContent>
        @if (_environments is null || _environments.Count == 0)
        {
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Secondary">@UiStrings.Pin_NoEnvironments</FlareText>
        }
        else
        {
            <FlareStack Gap="FlareSpacing.Small">
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Secondary">@UiStrings.Pin_Intro</FlareText>
                @foreach (var env in _environments.OrderBy(e => e.Order))
                {
                    var pin = _pins.FirstOrDefault(p => p.EnvironmentId == env.Id);
                    <FlareStack Row Gap="FlareSpacing.Small" Align="FlareAlignItems.Center">
                        <FlareText Typo="TypographyScale.BodyMedium" Style="min-width:8rem;">@env.Key</FlareText>
                        @if (pin is null)
                        {
                            <FlareChip Size="ChipSize.Sm" Color="FlareColor.OnSurfaceVariant" Label="@UiStrings.Pin_State_Labels" />
                        }
                        else
                        {
                            <FlareChip Size="ChipSize.Sm" Color="@(pin.IsReady ? FlareColor.Success : FlareColor.Error)" Label="@(pin.IsReady ? UiStrings.Pin_State_Ready : UiStrings.Pin_State_Held)" />
                        }
                        <FlareSpacer />
                        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" Color="FlareColor.Success"
                                     OnClick="@(() => SetPin(env.Id, true))">@UiStrings.Pin_SetReady</FlareButton>
                        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" Color="FlareColor.Error"
                                     OnClick="@(() => SetPin(env.Id, false))">@UiStrings.Pin_SetHeld</FlareButton>
                        @if (pin is not null)
                        {
                            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text"
                                         OnClick="@(() => ClearPin(pin.Id))">@UiStrings.Pin_Clear</FlareButton>
                        }
                    </FlareStack>
                }
            </FlareStack>
        }
    </ChildContent>
    <Actions>
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => _showPins = false)">@UiStrings.Common_Close</FlareButton>
    </Actions>
</FlareDialog>

@code {
    [Parameter] public Guid Id { get; set; }
    [Inject] NavigationManager Nav { get; set; } = default!;

    TaskDetailDto? _task;
    RolloutPlanDto? _plan;
    List<EnvironmentDto>? _environments;
    Guid _selectedEnvironmentId;
    bool _redeploy;
    bool _loading = true;
    bool _busy;
    Dictionary<Guid, string> _keyById = [];
    Guid _loadedId;

    // Readiness-pin dialog for one merge request.
    bool _showPins;
    Guid _pinMrId;
    string _pinMrExternalId = "";
    List<ReadinessPinDto> _pins = [];

    async Task OpenPins(Guid mergeRequestId, string mrExternalId)
    {
        _pinMrId = mergeRequestId;
        _pinMrExternalId = mrExternalId;
        _pins = [];
        _showPins = true;
        await RunAsync(async () => _pins = await ReadinessApi.GetReadinessPinsAsync(mergeRequestId));
    }

    async Task SetPin(Guid environmentId, bool isReady)
    {
        if (await RunAsync(async () => await ReadinessApi.SetReadinessPinAsync(_pinMrId, environmentId, isReady), UiStrings.Pin_Saved))
            await RunAsync(async () => _pins = await ReadinessApi.GetReadinessPinsAsync(_pinMrId));
    }

    async Task ClearPin(Guid pinId)
    {
        if (await RunAsync(async () => await ReadinessApi.DeleteReadinessPinAsync(pinId), UiStrings.Pin_Cleared))
            await RunAsync(async () => _pins = await ReadinessApi.GetReadinessPinsAsync(_pinMrId));
    }

    // Merge requests forced into or out of this rollout.
    List<PlanMembershipDto> _membership = [];

    /// <summary>
    /// Forces a merge request in or out of the rollout, then rebuilds the plan so the screen shows
    /// the result rather than the request.
    /// </summary>
    /// <remarks>
    /// Recalculated here explicitly. The endpoint also asks for a rebuild, but that goes through the
    /// queue and lands whenever it lands - and the plan is read from storage now, so without this the
    /// operator would press exclude and watch nothing happen.
    /// </remarks>
    async Task SetMembership(Guid mergeRequestId, string state)
    {
        _busy = true;
        if (await RunAsync(
                async () => await TasksApi.SetPlanMembershipAsync(Id, mergeRequestId, state),
                UiStrings.Plan_Membership_Saved))
        {
            await RunAsync(async () => _plan = await TasksApi.RecalculateTaskPlanAsync(Id));
            await LoadMembership();
            RebuildKeyMap();
        }
        _busy = false;
    }

    Task LoadMembership() =>
        RunAsync(async () => _membership = await TasksApi.GetPlanMembershipAsync(Id));

    /// <summary>
    /// Keyed on the route parameter rather than on first render: the parent and subtask chips
    /// navigate to another task, and Blazor reuses this component for that - OnInitializedAsync
    /// would not run again, leaving the previous task's plan on screen under the new URL.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        await Load();
    }

    async Task Load()
    {
        _loading = true;
        // A null plan is a legitimate answer (nothing built yet), not a failure.
        await RunAsync(async () =>
        {
            _task = await TasksApi.GetTaskAsync(Id);
            _plan = await TasksApi.GetTaskPlanAsync(Id);
            _environments = await EnvironmentsApi.GetEnvironmentsAsync();
            _membership = await TasksApi.GetPlanMembershipAsync(Id);
        });
        var first = _environments?.FirstOrDefault(e => e.IsEnabled);
        if (first is not null && _selectedEnvironmentId == Guid.Empty) _selectedEnvironmentId = first.Id;
        RebuildKeyMap();
        _loading = false;
    }

    async Task Launch()
    {
        if (_selectedEnvironmentId == Guid.Empty) return;
        _busy = true;
        RolloutDto? rollout = null;
        var ok = await RunAsync(async () => rollout = await RolloutsApi.LaunchRolloutAsync(Id, _selectedEnvironmentId, _redeploy), UiStrings.TaskDetail_Launched);
        _busy = false;
        if (ok && rollout is not null) Nav.NavigateTo($"/rollouts/{rollout.Id}");
    }

    async Task Recalculate()
    {
        _busy = true;
        await RunAsync(async () => _plan = await TasksApi.RecalculateTaskPlanAsync(Id), UiStrings.TaskDetail_Recalculated);
        RebuildKeyMap();
        _busy = false;
    }

    bool _showYaml;
    string _yaml = "";

    /// <summary>Fetches the plan as YAML and shows it.</summary>
    /// <remarks>
    /// Fetched rather than linked: the endpoint needs the bearer token, and a plain anchor would send
    /// the browser there without one and land on the sign-in page.
    /// </remarks>
    async Task ShowYaml()
    {
        _busy = true;
        if (await RunAsync(async () => _yaml = await TasksApi.ExportTaskPlanYamlAsync(Id)))
            _showYaml = true;
        _busy = false;
    }

    void RebuildKeyMap() => _keyById = _plan?.Nodes.ToDictionary(n => n.TaskId, n => n.TaskKey) ?? [];

    string KeyOf(Guid taskId) => _keyById.TryGetValue(taskId, out var k) ? k : taskId.ToString()[..8];

    /// <summary>Only enabled environments can be launched into, so only they are offered.</summary>
    List<EnvironmentDto>? EnabledEnvironments => _environments?.Where(e => e.IsEnabled).ToList();

    string EnvironmentLabel(Guid id)
    {
        var env = _environments?.FirstOrDefault(e => e.Id == id);
        return env is null ? id.ToString() : $"{env.Name} ({env.Key})";
    }

    void Back() => Nav.NavigateTo("/");

    /// <summary>Opens another task - the parent, or one of the subtasks.</summary>
    void Open(Guid taskId) => Nav.NavigateTo($"/tasks/{taskId}");

    // Mirrors the server-side MergeRequestStatus enum, which the PWA does not reference.
    static FlareColor StatusColor(string status) => status switch
    {
        "ReadyForDeploy" => FlareColor.Success,
        "Merged" => FlareColor.Primary,
        "Opened" => FlareColor.Secondary,
        "Closed" => FlareColor.OnSurfaceVariant,
        _ => FlareColor.Default
    };
}
