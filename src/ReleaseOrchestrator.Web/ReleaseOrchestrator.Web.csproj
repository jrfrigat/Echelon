<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Pinned above the 2.0.0 that AspNetCore.OpenApi resolves transitively: it carries a
         high-severity advisory (GHSA-v5pm-xwqc-g5wc). Drop the pin once the parent moves. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <!--
      Rebus.OpenTelemetry stitches the Ingress to RabbitMQ to Core path into one trace. It depends
      transitively on OpenTelemetry.Api 1.6.0, which carries a moderate advisory
      (GHSA-g94r-2vxg-569j) — but the three OpenTelemetry 1.17.x references above pull Api 1.17.x,
      which wins the version conflict, so the vulnerable one never resolves. No pin is needed; the
      CI vulnerable-package audit confirms it. If those OTel packages are ever downgraded below 1.9,
      the advisory comes back and this needs a direct OpenTelemetry.Api pin.
    -->
    <PackageReference Include="Rebus.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReleaseOrchestrator.Application\ReleaseOrchestrator.Application.csproj" />
    <ProjectReference Include="..\ReleaseOrchestrator.Infrastructure\ReleaseOrchestrator.Infrastructure.csproj" />
    <ProjectReference Include="..\ReleaseOrchestrator.Migrations.MsSql\ReleaseOrchestrator.Migrations.MsSql.csproj" />
    <ProjectReference Include="..\ReleaseOrchestrator.Pwa\ReleaseOrchestrator.Pwa.csproj" />
  </ItemGroup>

</Project>
