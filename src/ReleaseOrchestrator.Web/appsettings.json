{
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "AD": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Security": {
    "AllowedApiHosts": []
  },
  "Archiving": {
    "Enabled": true,
    "ArchiveAfterDays": 90,
    "TaskBatchSize": 1000,
    "MrBatchSize": 500,
    "StatusJournalRetentionDays": 730,
    "RolloutHistoryRetentionDays": 730,
    "PlanHistoryRetentionDays": 90
  },
  "RequestAudit": {
    "Enabled": true,
    "BufferCapacity": 10000,
    "BatchSize": 200,
    "FlushIntervalSeconds": 5,
    "MaxAnonymousRecordsPerMinute": 600,
    "RecordClientIp": true,
    "RecordUserName": true,
    "RetainDays": 14,
    "RetainNotableDays": 90,
    "PruneIntervalMinutes": 60,
    "PruneBatchSize": 5000,
    "HardRowCap": 20000000,
    "SummarySampleCap": 20000
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
