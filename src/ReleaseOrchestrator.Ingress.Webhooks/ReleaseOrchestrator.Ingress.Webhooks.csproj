<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Pinned above the 2.0.0 that AspNetCore.OpenApi resolves transitively: it carries a
         high-severity advisory (GHSA-v5pm-xwqc-g5wc). Drop the pin once the parent moves. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <!-- See ReleaseOrchestrator.Web.csproj for why this pin exists and what it costs. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReleaseOrchestrator.Application\ReleaseOrchestrator.Application.csproj" />
  </ItemGroup>

  <!--
    Both hosts must name services and sample sources identically, so the wiring is compiled from
    one source file rather than copied. Linking is a stopgap: the proper home is a small shared
    Observability project, which needs a solution change.
  -->
  <ItemGroup>
    <Compile Include="..\ReleaseOrchestrator.Web\Observability\*.cs" LinkBase="Observability" />
  </ItemGroup>

</Project>
