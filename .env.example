# Copy this file to .env and fill in real values before running docker compose.
# Never commit the actual .env file.

# ── SQL Server ────────────────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=YourStrong!Password1

# ── Azure AD / ADFS ───────────────────────────────────────────────────────────
# Authority URL: for Azure AD use https://login.microsoftonline.com/{tenantId}
# For on-premise ADFS use https://adfs.company.com/adfs
AD_AUTHORITY=https://login.microsoftonline.com/YOUR_TENANT_ID
AD_CLIENT_ID=YOUR_API_CLIENT_ID
AD_TENANT_ID=YOUR_TENANT_ID

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin from which the Blazor PWA is served (same host as core in hosted mode)
ALLOWED_ORIGIN=https://releaseorchestrator.company.com

# ── Webhook shared secrets ────────────────────────────────────────────────────
# One per connection name. The value must match the secret configured in GitLab/Tracker.
# Add entries for every connection: WEBHOOK_GITLAB_{NAME}_TOKEN, WEBHOOK_TRACKER_{NAME}_TOKEN
WEBHOOK_GITLAB_DEFAULT_TOKEN=change-me-gitlab-secret
WEBHOOK_TRACKER_DEFAULT_TOKEN=change-me-tracker-secret
