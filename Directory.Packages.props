<Project>
  <!--
    Central Package Management (CPM), mirroring the Flare repository's convention. Every NuGet
    package version used anywhere in this repo is declared ONCE here; individual .csproj files
    reference packages WITHOUT a Version attribute. To bump a dependency, edit this file only.

    Why it matters here specifically: before CPM the same package sat at different versions in
    different projects (Microsoft.AspNetCore.OpenApi at 9.0.8 while everything else was 9.0.5),
    which NuGet resolves silently by unifying upward - a version nobody chose.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Build-time only, in every project, PrivateAssets=all so they never flow to a consumer. MinVer
       derives the package version from the git tag; SourceLink embeds repository and commit metadata
       so the published packages are source-debuggable. -->
  <ItemGroup Label="Build and packaging">
    <GlobalPackageReference Include="MinVer" Version="7.0.0" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>
  <ItemGroup Label="ASP.NET Core / runtime">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <!-- Boots the real web host in-process for the API tests. Pinned to the same 10.0.10 as the rest
         of ASP.NET Core: the test host and the host it tests must be the same framework, or the test
         proves something about a version nobody deploys. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <!--
      Pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi resolves transitively: that version
      carries a high-severity advisory (GHSA-v5pm-xwqc-g5wc). Drop the pin once the parent package
      resolves a fixed one on its own.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- Test-only, pinned above the 2.1.11 the SQLite provider resolves: that carries a
         high-severity advisory (GHSA-2m69-gcr7-jv3q). Never shipped, but CI audits the whole
         graph and a known-vulnerable package is not worth arguing about. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="Rebus" Version="8.9.2" />
    <PackageVersion Include="Rebus.RabbitMq" Version="10.1.1" />
    <PackageVersion Include="Rebus.ServiceProvider" Version="10.7.2" />
    <PackageVersion Include="Rebus.OpenTelemetry" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup Label="Auth">
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.13.1" />
  </ItemGroup>
  <ItemGroup Label="Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <!-- Prometheus's exporter ships only as a pre-release; there is no stable line of it. It is
         pinned to the same 1.17 core as the packages above so the metrics pipeline stays coherent. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
  </ItemGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="Flare.Blazor" Version="0.17.1" />
    <PackageVersion Include="Flare.Theme.VisualStudio" Version="0.17.1" />
    <PackageVersion Include="Flare.Icons.MaterialDesign3.Svg" Version="0.17.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>